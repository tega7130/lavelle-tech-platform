// Lavelle — domain model.
// Vocabulary, entities and state machines are binding per the design
// handoff READMEs: candidate/programme/module/lecture/enrolment/cohort/
// intake/credit/applicant/registrar/faculty. Never "student" or "course".
//
// The candidate/session/audit tables below are a literal contract from
// Handoff 01's README — column names, types, nullability and indexes are
// kept verbatim because later slices reference them by name. See that
// README for the authoritative spec; deviations are called out inline.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, citext]
}

// ─── Candidate ───────────────────────────────────────────────────────────

// practising_lawyer | inhouse_counsel | law_graduate | law_student | regulated_non_lawyer | other
enum ProfessionalStatus {
  PRACTISING_LAWYER
  INHOUSE_COUNSEL
  LAW_GRADUATE
  LAW_STUDENT
  REGULATED_NON_LAWYER
  OTHER
}

// 0_2 | 3_5 | 6_10 | 10_plus — Prisma enum identifiers can't start with a
// digit, so the DB-level label is pinned with @map and the Prisma-side name
// is just a valid spelling of it.
enum ExperienceBand {
  Y0_2     @map("0_2")
  Y3_5     @map("3_5")
  Y6_10    @map("6_10")
  Y10_PLUS @map("10_plus")
}

// active | suspended. Deliberately NOT applicant/enrolled — is_enrolled is
// derived from candidate_number IS NOT NULL, never stored (Handoff 01 rule 1).
enum CandidateAccountStatus {
  ACTIVE
  SUSPENDED
}

model Candidate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Issued at registration, permanent, never reused (LVL-APP-2026-04412).
  applicantNumber String  @unique @db.VarChar(24)
  // Null until first confirmed payment (LVL/2026/00291) — a second,
  // separate identifier from applicantNumber, never derived from it.
  candidateNumber String? @unique @db.VarChar(24)

  firstName       String    @db.VarChar(80)
  lastName        String    @db.VarChar(80)
  // citext — case-insensitive uniqueness/lookup is the point, not just storage.
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime?

  phoneCountryCode String    @default("+234") @db.VarChar(6)
  phone            String?   @db.VarChar(24)

  passwordHash String

  acceptedTermsAt DateTime
  marketingOptIn  Boolean  @default(false)

  accountStatus   CandidateAccountStatus @default(ACTIVE)
  suspendedAt     DateTime?
  suspendedReason String?
  reactivatedAt   DateTime?

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile                    CandidateProfile?
  emailVerificationTokens    EmailVerificationToken[]
  passwordResetOtpChallenges PasswordResetOtpChallenge[]
  notifications              Notification[]
  sessions                Session[]
  enrolments              Enrolment[]
  payments                Payment[]
  idCards                 IdCard[]
  certificates            Certificate[]
  examRegistrations       ExamRegistration[]
  supportRequests         SupportRequest[]
  supportMessages         SupportMessage[]
  candidateNotes          CandidateNote[]
  announcementDeliveries  AnnouncementDelivery[]
  reviews                 Review[]
  uploadedMediaAssets     MediaAsset[]

  @@index([accountStatus])
}

// One-to-one, all nullable — the profile-completion modal's output. Which
// conditional fields apply is decided by professionalStatus (see
// src/lib/onboarding.ts); enforced in the Zod schema, not only the UI.
model CandidateProfile {
  candidateId String    @id @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  professionalStatus ProfessionalStatus?
  yearOfCall         Int?                @db.SmallInt // lawyers only, 1960 <= n <= current year
  scnNumber          String?             @db.VarChar(24) // lawyers only
  institution        String?             @db.VarChar(160) // graduates/students
  graduationYear     Int?                @db.SmallInt // graduates/students
  organisation       String?             @db.VarChar(160) // regulated/other
  roleTitle          String?             @db.VarChar(120) // regulated/other
  experienceBand     ExperienceBand?
  placeOfPractice    String?             @db.VarChar(160)
  photoUrl           String?

  handbookAcknowledgedAt DateTime? // checklist step 5
  completedAt            DateTime? // set when the 3-step modal finishes
}

model EmailVerificationToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Store the hash, send the plaintext — never store a usable token.
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([candidateId, consumedAt])
}

// Registration's email-ownership step, before any Candidate row exists —
// keyed by email (not candidateId) for exactly that reason. A verified,
// unexpired row here is what lets registerCandidate skip the old
// magic-link flow and set emailVerifiedAt at creation time.
model EmailOtpChallenge {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  email String @db.Citext

  // Store the hash, send/log the plaintext — same rule as EmailVerificationToken.
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, verifiedAt])
}

// Forgot-password step for a candidate account that already exists —
// keyed by candidateId (not email, unlike EmailOtpChallenge) because the
// account is real by the time this is created; the request/verify Server
// Actions still take the submitted email and resolve it to a candidate
// themselves, so the account's existence is never revealed either way.
model PasswordResetOtpChallenge {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([candidateId, verifiedAt])
}

enum NotificationCategory {
  ACCOUNT
  CREDENTIAL
  PROGRAMME
  ASSESSMENT
  FINANCE
  SUPPORT
  ANNOUNCEMENT
  EXAMINATION
}

// Slice 10: staffId added so a support-request assignment can notify the
// assignee through the same table/read path as every candidate
// notification, rather than a parallel staff-only inbox. Same
// exactly-one-owner CHECK constraint as Session.
model Notification {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String?    @db.Uuid
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  staffId     String?
  staff       Staff?     @relation("StaffNotifications", fields: [staffId], references: [id], onDelete: Cascade)

  category NotificationCategory
  title    String               @db.VarChar(160)
  body     String
  readAt   DateTime?

  createdAt DateTime @default(now())

  @@index([candidateId, createdAt(sort: Desc)])
  @@index([staffId, createdAt(sort: Desc)])
}

// Database-backed candidate sessions — deliberately NOT a stateless JWT.
// Suspending an account revokes every live session immediately, which a
// self-contained token can't do. Read via a cached getCurrentCandidate()
// (src/lib/candidate-session.ts): revokedAt IS NOT NULL or
// accountStatus = SUSPENDED both mean signed out. Cookie carries the
// opaque plaintext token; only its hash is ever persisted.
// Slice 10: one session table for both applications, not two — candidate
// and staff sign-in remain entirely separate cookies/paths (see
// staff-session.ts's header), but they share this table, its revocation
// path, and its expiry semantics. Exactly one of candidateId/staffId is
// non-null (enforced by a CHECK constraint hand-added in the migration —
// Prisma has no first-class syntax for it yet).
model Session {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String?    @db.Uuid
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  staffId     String?
  staff       Staff?     @relation("StaffSessions", fields: [staffId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime

  revokedAt DateTime? // set on logout, on suspension/deactivation, on password change
  userAgent String?
  ipAddress String?   @db.Inet

  createdAt DateTime @default(now())

  @@index([candidateId, revokedAt])
  @@index([staffId, revokedAt])
}

// ─── Slice 08: Staff, roles & permissions ────────────────────────────────
//
// StaffRole/StaffStatus/Permission are Handoff-era scaffolding, replaced
// wholesale here to match Slice 08's real catalogue and role set —
// mechanically renamed throughout every prior slice's permission checks
// (see the Slice 08 summary for the full old->new mapping).

enum StaffRole {
  SUPER_ADMIN
  REGISTRAR
  ACADEMIC_ADMIN
  FACULTY
  FINANCE
  SUPPORT
  READ_ONLY
  CONTENT_MANAGER
}

enum StaffStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

// The 17-permission catalogue (README table) — SUPER_ADMIN is a ROLE, not
// a permission here (rule: "SUPER_ADMIN holds all of them implicitly —
// but store the grants anyway", so a super admin literally holds all 17
// StaffPermission rows rather than one bypass flag).
enum Permission {
  VIEW_CANDIDATES
  EDIT_CANDIDATE_DETAILS
  SUSPEND_CANDIDATES
  MANAGE_PROGRAMMES
  MANAGE_INTAKES_COHORTS
  MARK_SUBMISSIONS
  MODERATE_GRADES
  MANAGE_EXAMS
  RESET_CANDIDATE_PROGRESS
  VIEW_FINANCE
  CONFIRM_PAYMENTS
  MANAGE_FINANCE
  ISSUE_CERTIFICATES
  REVOKE_CERTIFICATES
  MANAGE_ANNOUNCEMENTS
  MANAGE_BLOG
  RESPOND_SUPPORT
  MANAGE_STAFF
  VIEW_AUDIT_LOG
}

model Staff {
  id String @id @default(cuid())

  // Kept as one field rather than the README's firstName/lastName split —
  // a low-stakes structural choice with no business-rule weight, and
  // every existing display site (all seven prior slices) already reads
  // it this way. Documented deviation, not an oversight.
  name       String
  email      String  @unique // the login
  phone      String?
  jobTitle   String?
  department String?

  lineManagerId String?
  lineManager   Staff?  @relation("StaffReports", fields: [lineManagerId], references: [id])
  reports       Staff[] @relation("StaffReports")

  role   StaffRole
  status StaffStatus @default(INVITED)

  // Slice 10: nullable — a freshly INVITED account has no password until
  // setStaffPassword activates it. INVITED now means "cannot sign in, no
  // password set" (README A3), not just a display tag.
  passwordHash String?
  activatedAt  DateTime?

  invitedByStaffId String?
  invitedBy        Staff?    @relation("StaffInvitedBy", fields: [invitedByStaffId], references: [id])
  invited          Staff[]   @relation("StaffInvitedBy")
  lastActiveAt     DateTime?

  // Slice 11 Part G: suspension is reversible (leave, an investigation)
  // and distinct from DEACTIVATED (the person has left) — both revoke
  // sessions immediately and both refuse sign-in indistinguishably from a
  // wrong password (README G2/G3). suspendedReason is mandatory at the
  // action layer, not the schema, matching every other "required reason"
  // field in this codebase (statusReason, declineReason, etc.).
  suspendedAt        DateTime?
  suspendedReason    String?
  suspendedByStaffId String?
  suspendedByStaff   Staff?    @relation("StaffSuspendedBy", fields: [suspendedByStaffId], references: [id])
  suspendedStaff     Staff[]   @relation("StaffSuspendedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissionGrants   StaffPermission[] @relation("StaffPermissionHolder")
  grantedPermissions StaffPermission[] @relation("StaffPermissionGrantedBy")

  auditEvents             AuditEvent[]
  revokedCertificates     Certificate[]         @relation("CertificateRevokedBy")
  createdProgrammes       Programme[]           @relation("ProgrammeCreatedBy")
  uploadedMediaAssets     MediaAsset[]
  confirmedPayments       Payment[]             @relation("PaymentConfirmedBy")
  facultyLeadCohorts      Cohort[]              @relation("CohortFacultyLead")
  markedMarks             Mark[]                @relation("MarkMarkedBy")
  moderatedMarks          Mark[]                @relation("MarkModeratedBy")
  publishedExams          Exam[]                @relation("ExamPublishedBy")
  closedExams             Exam[]                @relation("ExamClosedBy")
  archivedExams           Exam[]                @relation("ExamArchivedBy")
  retiredExamQuestions    ExamQuestion[]        @relation("ExamQuestionRetiredBy")
  issuedCertificates      Certificate[]         @relation("CertificateIssuedBy")
  certificateTemplates    CertificateTemplate[] @relation("CertificateTemplateCreatedBy")
  assignedSupportRequests SupportRequest[]      @relation("SupportRequestAssignedTo")
  supportMessages         SupportMessage[]
  candidateNotesAuthored  CandidateNote[]
  announcementsCreated    Announcement[]
  publishedListings       ProgrammeListing[]    @relation("ListingPublishedBy")
  enquiriesHandled        ContactEnquiry[]      @relation("EnquiryHandledBy")

  sessions             Session[]              @relation("StaffSessions")
  notifications        Notification[]         @relation("StaffNotifications")
  invitationTokens     StaffInvitationToken[] @relation("StaffInvitationTokenHolder")
  sentInvitations      StaffInvitationToken[] @relation("StaffInvitationTokenSender")
  assignedByRequests   SupportRequest[]       @relation("SupportRequestAssignedBy")
  resolvedRequests     SupportRequest[]       @relation("SupportRequestResolvedBy")
  reviewedSittings     Sitting[]              @relation("SittingReviewedBy")
  moderatedReviews     Review[]               @relation("ReviewModeratedBy")
  examAssignments      ExamStaffAssignment[]  @relation("ExamStaffAssignmentHolder")
  examAssignmentsGiven ExamStaffAssignment[]  @relation("ExamStaffAssignmentGrantedBy")
  blogPostsPublished   BlogPost[]             @relation("BlogPostPublishedBy")
  blogPostsCreated     BlogPost[]             @relation("BlogPostCreatedBy")

  @@index([role])
  @@index([status])
}

// Slice 10 — mirrors EmailVerificationToken (Slice 01) deliberately:
// same shape, same rules (hash stored, plaintext sent, single use,
// 48-hour expiry), different subject.
model StaffInvitationToken {
  id      String @id @default(uuid())
  staffId String
  staff   Staff  @relation("StaffInvitationTokenHolder", fields: [staffId], references: [id], onDelete: Cascade)

  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?

  // Null for a self-service password reset (requestStaffPasswordReset) —
  // there is no inviter, the staff member requested it themselves. Set
  // for a real invitation, where the set-password page names the inviter.
  invitedByStaffId String?
  invitedByStaff   Staff?  @relation("StaffInvitationTokenSender", fields: [invitedByStaffId], references: [id])

  createdAt DateTime @default(now())

  @@index([staffId, consumedAt])
}

// Presence IS the grant (rule 1: "the grant is the authority") — no soft
// `granted` boolean; revoking a permission deletes the row. Seeded from
// the role's preset on creation or when a preset is (re-)applied;
// individual toggles write/delete a row directly here and audit-log it.
// SUPER_ADMIN is a StaffRole, not a Permission — a super admin holds
// real rows for all 17 permissions (README: "store the grants anyway"),
// not a bypass flag, so this table always has the true authorization
// state with no special-cased exception.
model StaffPermission {
  staffId String
  staff   Staff  @relation("StaffPermissionHolder", fields: [staffId], references: [id], onDelete: Cascade)

  permission Permission

  grantedByStaffId String
  grantedByStaff   Staff    @relation("StaffPermissionGrantedBy", fields: [grantedByStaffId], references: [id])
  grantedAt        DateTime @default(now())

  @@id([staffId, permission])
}

// ─── Programme, module, lecture ─────────────────────────────────────────
//
// The deepest schema in the system (Handoff Slice 02) — column names and
// types kept verbatim from that README because the catalogue, course
// player, quizzes, exam question bank and certificates all read this.
// Nothing here is candidate-facing.

enum ProgrammeTier {
  FOUNDATION
  SPECIALIST
  ADVANCED_PRACTITIONER
}

// DRAFT is the authoring state. ACTIVE means open for enrolment — it is
// NOT website publication (a separate flag Slice 09 adds); a programme
// can be ACTIVE and unpublished on the marketing site at the same time.
// Conflating the two would make unpublishing silently close enrolment.
enum ProgrammeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Administrators pick an existing category or create one inline while
// authoring. Case-insensitive dedupe on `name` happens in the service
// (createCategory), not here — Postgres citext would also work but the
// spec gives a plain unique String, so the dedupe check stays app-side.
model ProgrammeCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programmes Programme[]
}

model Programme {
  id    String @id @default(uuid())
  code  String @unique // e.g. ELR-201 — immutable once any enrolment exists (rule 3)
  title String

  categoryId String
  category   ProgrammeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  tier   ProgrammeTier
  status ProgrammeStatus @default(DRAFT)

  summary String // the paragraph shown in the catalogue and public listing

  authorName String? // optional — free text, not a Staff/user reference

  weeks            Int // 8 Foundation · 12 Specialist · 16 Advanced — stored, never derived from tier
  weeklyHoursLabel String // free text range, e.g. "6–8 hrs / week" — a label, not a number

  feeMinor Int // naira KOBO, integer minor units — ₦450,000 is 45000000. Never a float.
  currency String @default("NGN")

  deliveryLabel    String         @default("Online + proctored exam")
  prerequisiteTier ProgrammeTier? // non-null only for ADVANCED_PRACTITIONER; Slice 06 enforces it

  // Slice 05 rule 7/10: enforced in openMarkable's QUERY (the candidate's
  // name/number are never selected), not by hiding a field in the UI.
  blindMarking Boolean @default(false)

  // A candidate-facing explainer video shown on the catalogue detail page
  // — either a pasted hosted URL (e.g. YouTube, nothing to probe) or an
  // uploaded asset, same either/or shape as Lecture.videoUrl/videoAssetId.
  coverVideoUrl     String?
  coverVideoAssetId String?
  coverVideoAsset   MediaAsset? @relation("ProgrammeCoverVideo", fields: [coverVideoAssetId], references: [id])

  createdByStaffId String
  createdBy        Staff  @relation("ProgrammeCreatedBy", fields: [createdByStaffId], references: [id])

  // True only for the shell row auto-created behind a "standalone exam"
  // (an exam with no real Lavelle programme behind it — createStandaloneExam
  // in exam-builder-actions.ts). Kept status DRAFT and excluded from
  // listProgrammes' default query so it never surfaces in the admin
  // Programmes list, the candidate enrolment catalogue, or the public
  // site — admins manage it entirely through the exam builder and should
  // never need to know a Programme row exists underneath it.
  isExamOnlyShell Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules              Module[]
  assessmentWeightings AssessmentWeighting[]
  cohorts              Cohort[]
  enrolments           Enrolment[]
  // No direct payments relation — Payment references Enrolment, not
  // Programme, directly (see the README's Payment table); go through
  // enrolment.programme to reach a payment's programme.
  certificates         Certificate[]
  exam                 Exam?
  listing              ProgrammeListing?
  reviews              Review[]
  enquiries            ContactEnquiry[]
  guestCheckouts       GuestCheckout[]

  @@index([status, tier])
  @@index([categoryId])
}

model Module {
  id          String    @id @default(uuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  weekNumber Int // 1-based
  title      String
  summary    String?

  // How many approved objective questions this module contributes to the
  // certifying examination. Slice 06 reads it and blocks publishing an
  // examination while a module has fewer approved questions than this —
  // this slice only stores the number, it does not enforce that check.
  examQuestionDraw Int @default(2)

  // Explicit ordering, independent of weekNumber — reordering must not
  // renumber weeks (rule 9).
  orderIndex Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lectures      Lecture[]
  examQuestions ExamQuestion[] // Slice 06's certifying-exam bank — distinct from the formative Quiz below (see that model's comment)
  quiz          Quiz?
  deadlines     Deadline[]

  @@unique([programmeId, weekNumber])
  @@index([programmeId, orderIndex])
}

enum LectureMediaKind {
  SLIDES
  VIDEO
}

// DRAFT — hidden from candidates while authoring. PUBLISHED — visible and
// accessible. ARCHIVED — the soft-delete state (rule: never hard-delete a
// Lecture/Quiz once candidates may have progress against it); hidden from
// candidates same as DRAFT, but distinct so admins can tell "never
// released" apart from "removed after release". Existing rows default to
// PUBLISHED so this migration doesn't hide already-live content.
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// NONE — no audio.
// PER_SLIDE — each slide carries its own narrationAssetId; narrationAutoAdvance
//   decides whether finishing it advances the slide.
// FULL_LECTURE — one fullNarrationAssetId for the whole lecture;
//   narrationAutoAdvance is meaningless there and must be stored false.
enum NarrationMode {
  NONE
  PER_SLIDE
  FULL_LECTURE
}

model Lecture {
  id       String @id @default(uuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  orderIndex Int
  title      String
  status     ContentStatus @default(PUBLISHED)

  mediaKind LectureMediaKind
  videoUrl  String? // video only — a pasted hosted URL; nothing to probe, duration shows "pending"

  // Only meaningful when videoUrl is a pasted link (YouTube etc.) — an
  // uploaded video's duration is videoAsset.durationSeconds instead,
  // probed server-side at upload. A pasted link has nothing to probe, so
  // this stays null until the candidate player reports it once via the
  // YouTube IFrame API (see recordVideoWatchProgress) — first report
  // wins, never overwritten afterward, since it's the same video for
  // every candidate.
  durationSeconds Int?

  // Not in the README's literal table — added because the duration rule
  // ("...or the video's duration") is only achievable for a video that
  // was actually uploaded (and so has bytes to probe), as distinct from
  // videoUrl above (a pasted URL, where there is genuinely nothing to
  // probe and "Duration pending" is correct, not a gap).
  // Not @unique — a MediaAsset can be referenced by more than one lecture
  // (duplicateProgramme shares uploaded bytes by reference rather than
  // copying them; nothing in the README requires strict 1:1 either).
  videoAssetId String?
  videoAsset   MediaAsset? @relation("LectureVideo", fields: [videoAssetId], references: [id])

  narrationMode        NarrationMode @default(NONE)
  narrationAutoAdvance Boolean       @default(false) // only meaningful when PER_SLIDE
  narrationRequireFull Boolean       @default(false) // must the candidate hear a slide out before advancing

  fullNarrationAssetId String? // only when FULL_LECTURE
  fullNarrationAsset   MediaAsset? @relation("LectureFullNarration", fields: [fullNarrationAssetId], references: [id])

  scenarioPrompt   String? // the applied-scenario step
  scenarioGuidance String?

  draftingPrompt    String? // the faculty-marked drafting exercise
  draftingWordLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slides              Slide[]
  progress            LectureProgress[]
  videoWatchProgress  VideoWatchProgress[]
  draftingSubmissions DraftingSubmission[]
  deadlines           Deadline[]
  rubrics             MarkRubric[]
  notes               LectureNote[]

  @@index([moduleId, orderIndex])
}

model Slide {
  id        String  @id @default(uuid())
  lectureId String
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  orderIndex Int
  title      String?
  body       String? // markdown

  imageAssetId String?
  imageAsset   MediaAsset? @relation("SlideImage", fields: [imageAssetId], references: [id])

  narrationAssetId String? // the per-slide audio
  narrationAsset   MediaAsset? @relation("SlideNarration", fields: [narrationAssetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lectureId, orderIndex])
}

// One table for every upload — narration audio, slide images, lecture
// video, certificate artwork. storageKey is an object-storage key, never
// a public URL — content is only ever reachable through a signed,
// expiring URL (rule 10). durationSeconds is required for audio/video and
// is probed server-side on upload (src/lib/uploads.ts); a lecture's
// estimated duration is always derived by summing these, never entered.
model MediaAsset {
  id String @id @default(uuid())

  kind       String // "audio" | "image" | "video" | "document"
  storageKey String @unique
  mimeType   String
  bytes      Int

  durationSeconds Int? // required for audio/video, probed not trusted from the client

  originalFilename String

  // Exactly one of these is set (hand-added CHECK constraint below,
  // mirroring Session/Notification) — this row was uploaded either by
  // staff (programme/finance/certificate content) or by a candidate
  // (their own profile photo), never both, never neither.
  uploadedByStaffId     String?
  uploadedBy            Staff?     @relation(fields: [uploadedByStaffId], references: [id])
  uploadedByCandidateId String?    @db.Uuid
  uploadedByCandidate   Candidate? @relation(fields: [uploadedByCandidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Arrays, not single relations — not @unique on the FK side above, so a
  // MediaAsset can be shared by more than one lecture/slide.
  lectureFullNarrations   Lecture[]             @relation("LectureFullNarration")
  lectureVideos           Lecture[]             @relation("LectureVideo")
  slideImages             Slide[]               @relation("SlideImage")
  slideNarrations         Slide[]               @relation("SlideNarration")
  receiptForPayments      Payment[]             @relation("PaymentReceipt")
  idCardPhotos            IdCard[]              @relation("IdCardPhoto")
  draftingAttachments     DraftingSubmission[]  @relation("DraftingAttachment")
  certificatePdf          Certificate?          @relation("CertificatePdf")
  certificateArtworks     CertificateTemplate[] @relation("CertificateArtwork")
  listingHeroes           ProgrammeListing[]
  listingVideos           ProgrammeListing[]    @relation("ListingVideo")
  coverVideoForProgrammes Programme[]           @relation("ProgrammeCoverVideo")
  blogPostHeroes          BlogPost[]
}

// Module-close quizzes — auto-marked and formative. NOT the examination
// question bank (a different table Slice 06 owns): a quiz question is
// drawn from nowhere and always shown; an examination question is drawn,
// shuffled, and summative. Do not conflate them.
model Quiz {
  id       String @id @default(uuid())
  moduleId String @unique
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  status ContentStatus @default(PUBLISHED)

  passMarkPercent Int @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id     String @id @default(uuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  orderIndex  Int
  prompt      String
  marks       Int     @default(1)
  explanation String? // shown after marking

  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId, orderIndex])
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  orderIndex Int
  text       String
  // Exactly one true per question — enforced in the service (upsertQuiz), not by a DB constraint.
  isCorrect  Boolean @default(false)

  answers QuizAnswer[]

  @@index([questionId, orderIndex])
}

enum AssessmentKind {
  QUIZ
  DRAFTING
  EXAMINATION
}

// The 20/40/40 split is a property of the programme, not a constant in
// code. The three weights must total exactly 100 — validated on write
// (upsertAssessmentWeighting), because Slice 05 computes a final mark
// from whatever is stored here regardless.
model AssessmentWeighting {
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  kind          AssessmentKind
  weightPercent Int

  @@id([programmeId, kind])
}

// ─── Intake, cohort, enrolment ──────────────────────────────────────────

// ─── Slice 03: catalogue, payment & enrolment ───────────────────────────
//
// This is the slice where an applicant becomes a candidate. Column names,
// types and indexes are kept verbatim from that README — the enrolment
// transaction, the webhook handler and the offline-recording action all
// depend on this exact shape. Deviations are called out inline.

enum IntakeMonth {
  JANUARY
  APRIL
  SEPTEMBER
}

enum IntakeStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model Intake {
  id     String       @id @default(uuid())
  month  IntakeMonth
  year   Int
  status IntakeStatus @default(OPEN)

  enrolmentOpensAt  DateTime
  enrolmentClosesAt DateTime
  startsAt          DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohorts        Cohort[]
  enrolments     Enrolment[]
  guestCheckouts GuestCheckout[]

  @@unique([month, year])
}

model Cohort {
  id          String    @id @default(uuid())
  code        String    @unique // e.g. "SPEC-ENR-03"
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  intakeId    String
  intake      Intake    @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  capacity Int

  facultyLeadStaffId String?
  facultyLead        Staff?  @relation("CohortFacultyLead", fields: [facultyLeadStaffId], references: [id])

  // OPEN | FULL | IN_PROGRESS | COMPLETED — a plain string per the README
  // (not an enum), so a new operational state doesn't need a migration.
  status String @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrolments Enrolment[]

  @@index([programmeId, intakeId])
}

// PENDING_PAYMENT -> ACTIVE -> COMPLETED, or -> WITHDRAWN | REFUNDED.
// WITHDRAWN/REFUNDED are the only statuses a candidate can hold two live
// rows around for the same programme (see the partial unique index below)
// — re-enrolment after leaving is allowed.
enum EnrolmentStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  WITHDRAWN
  REFUNDED
}

model Enrolment {
  id          String    @id @default(uuid())
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])
  // Assigned on confirmation (enrolment transaction step 5) — null until then.
  cohortId    String?
  cohort      Cohort?   @relation(fields: [cohortId], references: [id])
  intakeId    String
  intake      Intake    @relation(fields: [intakeId], references: [id])

  // Business rule 1: this record's existence at ACTIVE, and the cohort
  // placement, follow confirmed payment — never acceptance, never an
  // admin flag.
  status EnrolmentStatus @default(PENDING_PAYMENT)

  enrolledAt   DateTime? // set when status becomes ACTIVE — i.e. on payment confirmation
  completedAt  DateTime? // a later slice sets this
  withdrawnAt  DateTime?
  refundedAt   DateTime?
  // Required for WITHDRAWN and REFUNDED; written to the audit log.
  statusReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments            Payment[]
  lectureProgress     LectureProgress[]
  videoWatchProgress  VideoWatchProgress[]
  draftingSubmissions DraftingSubmission[]
  quizAttempts        QuizAttempt[]
  deadlines           Deadline[]
  marks               Mark[]
  programmeResult     ProgrammeResult?
  examRegistrations   ExamRegistration[]
  certificates        Certificate[]
  reviews             Review[]
  notes               LectureNote[]

  // Partial unique index — a candidate cannot hold two live enrolments in
  // the same programme, but may re-enrol after withdrawing. Prisma cannot
  // express a WHERE clause on a unique index, so this is written as raw
  // SQL in the migration (enrolment_one_live_per_programme) and is not
  // enforced by this @@index declaration alone.
  @@index([candidateId, status])
  @@index([cohortId, status])
  @@index([programmeId])
}

// ─── Slice 04: course player progress & deadlines ───────────────────────
//
// Progress is scoped to the ENROLMENT, never the candidate alone (rule 1)
// — a re-enrolment after withdrawal starts clean while the prior record
// survives for the registrar. Module and programme percentages are always
// DERIVED on read from these rows against the current module/lecture
// counts (src/lib/progress.ts) — never stored, since Slice 02 lets an
// administrator add a lecture at any time and a stored percentage would
// be wrong the moment they do.

enum LectureState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LectureProgress {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  lectureId   String
  lecture     Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  state LectureState @default(NOT_STARTED)

  slideIndex           Int @default(0) // resume position for slide lectures
  mediaPositionSeconds Int @default(0) // resume position for video, and within a full-lecture narration

  // Subset of ['content','scenario','drafting','quiz'] — whichever steps
  // deriveLectureSteps() returns for this lecture. A lecture completes
  // when this set covers every authored step (rule 3), never a hardcoded
  // four — a lecture with no drafting prompt completes in three.
  stepsCompleted String[]

  startedAt   DateTime?
  completedAt DateTime?
  lastSeenAt  DateTime  @default(now()) // drives "continue where you left off"

  @@unique([enrolmentId, lectureId])
  @@index([enrolmentId, lastSeenAt(sort: Desc)])
}

// Engagement tracking, distinct from LectureProgress.mediaPositionSeconds
// (a resume cursor that can move backward on rewind) — maxPositionSeconds
// only ever increases, so it's "how much of the video has this candidate
// ever gotten to," the number analytics actually wants. Watched % and
// "completed" are deliberately NOT stored here — they're derived at read
// time from this value against the lecture's duration (videoAsset's
// probed durationSeconds for an upload, or Lecture.durationSeconds for a
// pasted link — see there), so there's only ever one place a duration
// figure can go stale. Keyed by enrolment (not candidateId directly),
// mirroring LectureProgress, so a reset via resetEnrolmentProgress
// (src/lib/candidate-progress.ts) clears it the same way. Covers both
// self-hosted <video> (timeupdate) and a YouTube embed (IFrame Player
// API) — both report through the same recordVideoWatchProgress call.
model VideoWatchProgress {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  lectureId   String
  lecture     Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  maxPositionSeconds Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrolmentId, lectureId])
  @@index([lectureId])
}

enum SubmissionState {
  DRAFT
  SUBMITTED
  RETURNED
  RESUBMITTED
}

// Marking fields (grade, feedback, markedByStaffId) belong to Slice 05 —
// deliberately absent here.
model DraftingSubmission {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  lectureId   String
  lecture     Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  state SubmissionState @default(DRAFT)

  body      String @default("") // the candidate's text — autosaved in DRAFT state (rule 12)
  wordCount Int    @default(0) // computed server-side; the limit is authored on the lecture

  attachmentAssetId String?
  attachmentAsset   MediaAsset? @relation("DraftingAttachment", fields: [attachmentAssetId], references: [id])

  submittedAt   DateTime?
  // Incremented on resubmission after a Refer (rule 4) — requestResubmission
  // opens the next attempt; the prior one, and its Mark, are never overwritten.
  attemptNumber Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mark Mark?

  @@unique([enrolmentId, lectureId, attemptNumber])
}

// A private, free-form note per (enrolment, lecture) — not a step, never
// gates progression. body is a small constrained markup string produced
// by the rich text editor's DOM serializer (never raw HTML — see
// src/lib/rich-text.ts), so it is always safe to render directly.
model LectureNote {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  lectureId   String
  lecture     Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  body String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrolmentId, lectureId])
  @@index([enrolmentId, updatedAt(sort: Desc)])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  attemptNumber Int @default(1)

  scorePercent Int? // null until submitted
  passed       Boolean? // against the quiz's authored passMarkPercent

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  answers QuizAnswer[]

  @@index([enrolmentId, quizId])
}

// isCorrect is graded SERVER-SIDE on submission (rule 4/6) — never sent to
// or trusted from the client. See src/lib/quiz-grading.ts.
model QuizAnswer {
  id         String       @id @default(uuid())
  attemptId  String
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId String?
  selectedOption   QuizOption? @relation(fields: [selectedOptionId], references: [id])

  isCorrect Boolean

  @@unique([attemptId, questionId])
}

enum DeadlineKind {
  LECTURE_RELEASE
  DRAFTING_DUE
  QUIZ_DUE
  EXAMINATION
}

// DeadlineState (UPCOMING/DUE_SOON/OVERDUE/MET/WAIVED) is computed from
// these timestamps on read (src/lib/deadline-state.ts) — never stored, since a
// stored state needs a cron job to stay honest and is wrong between runs
// (rule 10).
model Deadline {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  kind DeadlineKind

  lectureId String?
  lecture   Lecture? @relation(fields: [lectureId], references: [id])
  moduleId  String?
  module    Module?  @relation(fields: [moduleId], references: [id])

  title String

  dueAt         DateTime
  // Never mutated (rule 7/8) — the extension audit trail lives entirely in
  // the difference between this and dueAt.
  originalDueAt DateTime

  extendedReason String? // e.g. "Extended by 9 days — account suspended 31 July to 4 August"

  metAt    DateTime?
  waivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enrolmentId, dueAt])
  @@index([dueAt])
}

// ─── Slice 05: marking, grades & the assessment record ─────────────────
//
// The first slice where a staff member's judgement enters the candidate's
// permanent record, so almost every rule here is about traceability, not
// computation: a resolved band is STORED (never re-derived once the scale
// changes — src/lib/grading.ts resolves it once, at return time, against
// whichever GradeBandDefinition was in force on the assessment date), and
// a weighting snapshot travels with ProgrammeResult (never re-derived once
// AssessmentWeighting changes).

enum MarkState {
  AWAITING
  IN_REVIEW
  RETURNED
  RESUBMISSION_REQUESTED
}

enum GradeBand {
  DISTINCTION
  MERIT
  PASS
  REFER
}

enum MarkableKind {
  DRAFTING
  EXAMINATION_WRITTEN
}

// Bands are DATA, not constants (rule 2) — an institution changes its
// scale, but a certificate already issued must keep the band it was
// issued under.
model GradeBandDefinition {
  id         String    @id @default(uuid())
  band       GradeBand
  minPercent Int // inclusive floor
  label      String // "Distinction", "Merit", "Pass", "Refer"

  effectiveFrom DateTime
  effectiveTo   DateTime? // null = current

  @@index([effectiveFrom, effectiveTo])
}

// One row per marked artefact — polymorphic over the two markable kinds
// (rule: "one queue, two sources", built so a third could be added
// without restructuring). Resubmission never overwrites this row or its
// submission: requestResubmission opens a NEW DraftingSubmission attempt,
// which gets its OWN Mark row once marked — draftingSubmissionId is
// @unique per Mark for exactly this reason, so attempt 1's referral and
// attempt 2's remedy both survive as distinct, complete rows.
model Mark {
  id String @id @default(uuid())

  // Required for kind=DRAFTING (a DraftingSubmission always has one).
  // Nullable for kind=EXAMINATION_WRITTEN — an exam-only registration
  // (Slice 06 rule 14, ExamRegistration.enrolmentId null) has no
  // Enrolment at all; that Mark instead resolves its candidate via
  // examWrittenAnswer -> sitting -> registration.candidateId, and never
  // feeds a ProgrammeResult (releaseResults computes the Sitting's own
  // totalPercent directly).
  enrolmentId String?
  enrolment   Enrolment? @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  kind MarkableKind

  // Exactly one of the two is non-null.
  draftingSubmissionId String?             @unique
  draftingSubmission   DraftingSubmission? @relation(fields: [draftingSubmissionId], references: [id], onDelete: Cascade)
  // Slice 06's SittingAnswer, now that it exists — a written examination
  // answer enters this same queue as MarkableKind.EXAMINATION_WRITTEN
  // (Slice 06 rule 11), not a second marking system.
  examWrittenAnswerId  String?             @unique
  examWrittenAnswer    SittingAnswer?      @relation(fields: [examWrittenAnswerId], references: [id], onDelete: Cascade)

  state MarkState @default(AWAITING)

  scorePercent Int? // null until returned
  band         GradeBand? // resolved at return time and stored (rule 2)

  // Mandatory before RETURNED (rule 1) — enforced in returnMark, not by
  // this column's nullability, since a rubric-only autosave draft can
  // legitimately have no feedback yet.
  feedback String?

  // Per-criterion scores keyed by MarkRubricCriterion id — { [criterionId]: score }.
  // Present only when a rubric is attached; criterion maxMarks sum to 100.
  rubricScores Json?

  markedByStaffId String?
  markedByStaff   Staff?    @relation("MarkMarkedBy", fields: [markedByStaffId], references: [id])
  markedAt        DateTime?

  moderatedByStaffId String?
  moderatedByStaff   Staff?    @relation("MarkModeratedBy", fields: [moderatedByStaffId], references: [id])
  moderatedAt        DateTime?

  // Copied from the submission at queue time (rule 5/8) — shown to the
  // marker, never auto-penalised; whether lateness costs marks is an
  // academic judgement, not a system rule.
  isLate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, createdAt])
  @@index([enrolmentId])
  @@index([markedByStaffId, markedAt])
}

// Optional per-lecture rubric — criterion maxMarks must sum to 100 so a
// rubric score can be expressed as a percentage (enforced app-side, not a
// DB constraint, since it's checked at author time not write time).
model MarkRubric {
  id        String   @id @default(uuid())
  lectureId String?
  lecture   Lecture? @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  name      String

  criteria MarkRubricCriterion[]
}

model MarkRubricCriterion {
  id         String     @id @default(uuid())
  rubricId   String
  rubric     MarkRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  orderIndex Int
  label      String // "Structure", "Authority", "Drafting precision"
  maxMarks   Int
}

// The computed final mark for an enrolment — MATERIALISED, because it is
// cited on a certificate that outlives both the grading scale and the
// programme's weighting (rule 3/11).
model ProgrammeResult {
  id          String    @id @default(uuid())
  enrolmentId String    @unique
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  quizAveragePercent     Int?
  draftingAveragePercent Int?
  examinationPercent     Int? // from Slice 06

  finalPercent Int? // half-up, to the integer, once, at the end — never per component (rule 5)
  band         GradeBand?

  // The weights used, copied at computation time (rule 3) — Slice 02 lets
  // an administrator change a programme's weighting; without this, a
  // recomputation years later would silently produce a final mark that
  // disagrees with the one already printed on the certificate.
  weightingSnapshot Json

  computedAt DateTime?

  // False only once every component exists and the examination is
  // moderated (the second half is Slice 06's territory; this slice flips
  // it purely from component presence — see recomputeProgrammeResult).
  isProvisional Boolean @default(true)
}

// ─── Payments ────────────────────────────────────────────────────────────

enum PaymentPurpose {
  PROGRAMME_FEE
  EXAMINATION_FEE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// Bank transfer, cash at a branch, a POS terminal, or a cheque — recorded
// by a finance officer once cleared, never a candidate self-report.
enum OfflinePaymentMode {
  BANK_TRANSFER
  CASH_DEPOSIT
  POS_TERMINAL
  CHEQUE
}

model Payment {
  id          String     @id @default(uuid())
  // Null only for a guest checkout (candidate applied for a programme and
  // paid before an account existed) whose payment hasn't confirmed yet —
  // confirmPayment's guest branch creates the Candidate and backfills this
  // the moment the webhook fires. Every other payment has a candidate from
  // the start, same as before this column became nullable.
  candidateId String?    @db.Uuid
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  purpose          PaymentPurpose
  enrolmentId      String? // null for an examination fee
  enrolment        Enrolment?        @relation(fields: [enrolmentId], references: [id])
  // The FK lives on the OTHER side (ExamRegistration.paymentId), per the
  // Slice 06 README — a registration is created, then the fee payment is
  // attached to it, mirroring the fact that a registration can exist
  // (briefly) before payment. This is the reverse back-relation only.
  examRegistration ExamRegistration?
  // Present only for a guest checkout — holds the applicant's details
  // (name/email/password) until confirmPayment turns them into a real
  // Candidate. Reverse back-relation only; the FK lives on GuestCheckout.
  guestCheckout    GuestCheckout?

  // Kobo. A snapshot of the fee at the time of payment — never read the
  // live programme fee when displaying a historic payment (rule 7).
  amountMinor Int
  currency    String        @default("NGN")
  status      PaymentStatus @default(PENDING)

  provider          String // "paystack" | "flutterwave" | "bank_transfer"
  providerReference String? @unique // the provider's transaction reference
  // Ours — shown to the candidate and quoted in support, e.g. LVL-PAY-2026-11842.
  internalReference String  @unique

  initiatedAt   DateTime  @default(now())
  confirmedAt   DateTime?
  failedAt      DateTime?
  failureReason String? // provider message, sanitised for display

  // Non-null only for a manual confirmation (webhook confirmations leave
  // this null) — the audit trail for the highest-risk admin action.
  confirmedByStaffId     String?
  confirmedByStaff       Staff?  @relation("PaymentConfirmedBy", fields: [confirmedByStaffId], references: [id])
  manualConfirmationNote String? // mandatory when confirmedByStaffId is set

  // Non-null only for an offline recording.
  offlineMode         OfflinePaymentMode?
  offlineReference    String? // bank transaction reference, teller slip no., terminal reference, or cheque no.
  // The date the money actually arrived — NOT confirmedAt. A transfer
  // received on the 6th may be recorded on the 8th, and the ledger
  // reconciles against this column, not confirmedAt.
  offlineReceivedOn   DateTime?
  // Mandatory for an offline recording — held on the record permanently.
  receiptAssetId      String?
  receiptAsset        MediaAsset?         @relation("PaymentReceipt", fields: [receiptAssetId], references: [id])
  // Stamped when the finance officer ticks "I have verified this payment
  // against the bank statement" — the moment they take responsibility.
  statementVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId, createdAt(sort: Desc)])
  // Drives the "pending over 48 hours" alert.
  @@index([status, initiatedAt])
}

enum GuestCheckoutStatus {
  PENDING
  CONSUMED
}

// The "Apply for this programme" checkout-first flow: a visitor fills in
// name/email/password and pays before any Candidate row exists. This row
// holds those details — email already proven via the same OTP challenge
// registration uses — until confirmPayment's guest branch turns it into a
// real Candidate + Enrolment on the SUCCESS webhook, exactly the same
// moment payment would otherwise just activate an existing enrolment. If
// payment never confirms, this row (and its PENDING/FAILED Payment) simply
// sits unconsumed — no account is ever created, unlike a normal /register
// abandonment which does leave a real Candidate row behind.
model GuestCheckout {
  id String @id @default(uuid())

  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])
  intakeId    String
  intake      Intake    @relation(fields: [intakeId], references: [id])

  firstName    String @db.VarChar(80)
  lastName     String @db.VarChar(80)
  email        String @db.Citext
  passwordHash String

  // Proven via the same email-OTP challenge as registration before the
  // "proceed to payment" step is ever reachable — never taken on trust.
  emailVerifiedAt DateTime
  acceptedTermsAt DateTime
  marketingOptIn  Boolean  @default(false)

  // A second, unguessable secret alongside the Payment's own
  // internalReference (which is only a 5-digit suffix — not safe to expose
  // payment status against for someone with no session). The guest return
  // page requires both together.
  checkoutToken String @unique

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  status     GuestCheckoutStatus @default(PENDING)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
}

// Idempotency for provider callbacks — without this table a retried
// webhook enrols twice. Insert before processing; a duplicate insert
// (the unique constraint below) means already handled: return 200 and do
// nothing.
model WebhookEvent {
  id              String  @id @default(uuid())
  provider        String
  providerEventId String
  payload         Json // the raw body, stored verbatim
  signatureValid  Boolean

  processedAt DateTime? // null means received but not yet applied
  receivedAt  DateTime  @default(now())

  @@unique([provider, providerEventId])
}

// Issued on payment confirmation, never on acceptance (rule 3). Only one
// card per candidate has retiredAt IS NULL — reissue retires the current
// one and creates a successor via reissuedFromId, so the history stays
// legible.
model IdCard {
  id          String    @id @default(uuid())
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Matches the candidate number — and stays the SAME across a reissue
  // (a reprinted physical card keeps its number), so this can only be
  // unique among LIVE cards, never globally. Prisma can't express a WHERE
  // clause on @@unique (same discipline as ExamRegistration's
  // one-live-per-window index) — the real constraint is the raw partial
  // index in this model's migration.
  cardNumber String
  tier       ProgrammeTier // the highest tier the candidate holds

  issuedAt   DateTime
  validUntil DateTime
  retiredAt  DateTime?

  reissuedFromId String? @unique
  reissuedFrom   IdCard? @relation("IdCardReissue", fields: [reissuedFromId], references: [id])
  reissuedTo     IdCard? @relation("IdCardReissue")

  photoAssetId String?
  photoAsset   MediaAsset? @relation("IdCardPhoto", fields: [photoAssetId], references: [id])

  createdAt DateTime @default(now())

  @@index([candidateId])
  @@index([cardNumber])
}

// ─── Slice 06: examinations — builder, registration, sitting & results ──
//
// The credentialing act — the only part of the system where a candidate
// can lose something irreversibly (a forfeited sitting, an expired
// window). paperSnapshot is drawn once at start and never re-drawn
// (rule 3); expiresAt is computed once server-side and never recomputed
// (rule 4/7) — the displayed countdown is cosmetic, every write checks
// now() < expiresAt regardless of the client's clock.

enum ExamQuestionType {
  OBJECTIVE
  WRITTEN
}

// Retiring withdraws a question from future draws but preserves the
// record and can be restored; editing applies to future sittings only
// (rule 3/4) — paperSnapshot is what guarantees that.
enum ExamQuestionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SittingState {
  REGISTERED
  IN_PROGRESS
  SUBMITTED
  FORFEITED
  EXPIRED
  MARKED
  RELEASED
}

enum ExamOutcome {
  PASS
  REFER
}

enum AttemptPolicy {
  ONE_ATTEMPT
  TWO_ATTEMPTS
  ONE_RESIT_ON_REFERRAL
}

model Exam {
  id          String    @id @default(uuid())
  programmeId String    @unique
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  status ExamStatus @default(DRAFT)

  durationMinutes Int // 60-360, in 30-minute steps
  passMarkPercent Int           @default(60)
  attemptPolicy   AttemptPolicy @default(ONE_RESIT_ON_REFERRAL)

  feeMinor Int // kobo — a separate transaction from the programme fee (rule 5)

  enforceFullScreen       Boolean @default(true)
  warnOnTabSwitch         Boolean @default(true)
  shuffleQuestions        Boolean @default(true)
  shuffleOptions          Boolean @default(false)
  allowReviewBeforeSubmit Boolean @default(true)

  // Candidate-facing content, authored here and read verbatim by the
  // candidate exam-detail page — never hard-coded on that side. All
  // optional so a DRAFT exam can exist before anyone writes copy for it;
  // publishExam requires them filled in before PUBLISHED.
  description      String? // "About this examination"
  instructions     String? // candidate exam-day instructions
  examFormat       String? // e.g. "Objective + written"
  examinationAreas Json? // "What is examined" — string[]
  onPassing        Json? // "On passing" — string[]

  publishedAt        DateTime?
  publishedByStaffId String?
  publishedByStaff   Staff?    @relation("ExamPublishedBy", fields: [publishedByStaffId], references: [id])

  closedAt        DateTime?
  closedByStaffId String?
  closedByStaff   Staff?    @relation("ExamClosedBy", fields: [closedByStaffId], references: [id])

  archivedAt        DateTime?
  archivedByStaffId String?
  archivedByStaff   Staff?    @relation("ExamArchivedBy", fields: [archivedByStaffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions        ExamQuestion[]
  windows          ExamWindow[]
  registrations    ExamRegistration[]
  staffAssignments ExamStaffAssignment[]
  requirements     ExamRequirement[]
}

// Freeform, admin-authored eligibility notes — display-only (rule: no
// way to server-verify "2 years of experience"). Distinct from
// checkExamEligibility's hard tier-completion gate (exam-eligibility.ts),
// which stays a separate, unconditional check. An exam with zero rows
// here is "open to all" — no separate flag, one source of truth.
model ExamRequirement {
  id     String @id @default(uuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  text        String
  isMandatory Boolean @default(true)
  orderIndex  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId, orderIndex])
}

// A staff member given access to THIS exam specifically — its candidate
// roster, their sitting answers, and grading — without needing the
// blanket MANAGE_EXAMS permission (which already grants access to every
// exam, so an assignment is redundant for someone who already holds it;
// requireExamAccess checks both). Granting/revoking is itself gated on
// MANAGE_EXAMS.
model ExamStaffAssignment {
  id     String @id @default(uuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  staffId String
  staff   Staff  @relation("ExamStaffAssignmentHolder", fields: [staffId], references: [id], onDelete: Cascade)

  assignedByStaffId String
  assignedByStaff   Staff    @relation("ExamStaffAssignmentGrantedBy", fields: [assignedByStaffId], references: [id])
  assignedAt        DateTime @default(now())

  @@unique([examId, staffId])
  @@index([staffId])
}

// The certifying-exam bank — distinct from Slice 02's QuizQuestion (a
// quiz question is formative and auto-marked; an exam question is drawn,
// shuffled and summative). Draw is per module and type-aware (rule 2):
// OBJECTIVE questions are drawn to the module's examQuestionDraw; EVERY
// approved WRITTEN question is always included, regardless of position.
model ExamQuestion {
  id       String @id @default(uuid())
  examId   String
  exam     Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id])

  type   ExamQuestionType
  status ExamQuestionStatus @default(DRAFT)

  prompt String
  marks  Int

  examinerNote String? // shown to the candidate after marking
  guidance     String? // written only — what a strong answer covers
  wordLimit    Int? // written only

  retiredAt        DateTime?
  retiredReason    String? // mandatory on retire (rule 8)
  retiredByStaffId String?
  retiredByStaff   Staff?    @relation("ExamQuestionRetiredBy", fields: [retiredByStaffId], references: [id])

  // When a retire is really a replacement — the old question stays on
  // the record either way.
  supersededById String?       @unique
  supersededBy   ExamQuestion? @relation("ExamQuestionSupersession", fields: [supersededById], references: [id])
  supersedes     ExamQuestion? @relation("ExamQuestionSupersession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options ExamQuestionOption[]
  answers SittingAnswer[]

  @@index([examId, moduleId, status])
}

// Objective only. Exactly one correct — enforced app-side.
model ExamQuestionOption {
  id         String       @id @default(uuid())
  questionId String
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  orderIndex Int
  text       String
  isCorrect  Boolean @default(false)

  answers SittingAnswer[]
}

// Sittings are monthly.
model ExamWindow {
  id     String @id @default(uuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  opensAt              DateTime
  closesAt             DateTime
  registrationDeadline DateTime
  capacity             Int? // null = uncapped

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations ExamRegistration[]

  @@index([examId, opensAt])
}

model ExamRegistration {
  id String @id @default(uuid())

  candidateId String     @db.Uuid
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  examId      String
  exam        Exam       @relation(fields: [examId], references: [id])
  windowId    String
  window      ExamWindow @relation(fields: [windowId], references: [id])

  // Non-null only where the candidate took the programme — the sole
  // difference between a PATHWAY credential and an exam-only one
  // (rule 14). Both are valid credentials; never a status distinction.
  enrolmentId String?
  enrolment   Enrolment? @relation(fields: [enrolmentId], references: [id])

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  attemptNumber Int @default(1)

  registeredAt DateTime  @default(now())
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sitting Sitting?

  // Partial unique — one LIVE registration per candidate per window
  // (cancelledAt IS NULL) — written as raw SQL in the migration, same
  // discipline as Enrolment's partial unique index.
  @@index([candidateId, examId])
  @@index([windowId])
}

// Slice 11 Part B: a human's read of the ProctoringEvent trail for one
// sitting. Evidence, never a threshold — nothing sets this but the
// invigilation screen's Clear/Refer actions (README B3 rule 2).
enum ConductReview {
  PENDING
  CLEARED
  REFERRED
}

// The exam attempt itself. The server owns the clock.
model Sitting {
  id             String           @id @default(uuid())
  registrationId String           @unique
  registration   ExamRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  state SittingState @default(REGISTERED)

  startedAt   DateTime?
  // startedAt + durationMinutes, computed server-side at start and NEVER
  // recomputed (rule 4/7).
  expiresAt   DateTime?
  submittedAt DateTime?
  forfeitedAt DateTime?

  // The exact questions, order and options served — written once at
  // startSitting, every subsequent read serves from THIS (rule 3). Null
  // only before the sitting has been started.
  paperSnapshot Json?

  objectivePercent Int? // auto-marked on submission
  writtenPercent   Int? // from the Slice 05 marking queue, once returned
  totalPercent     Int?
  outcome          ExamOutcome?
  band             GradeBand? // resolved and stored, per Slice 05 rule 2

  releasedAt DateTime?

  // Slice 11 Part B: invigilatorFinding is mandatory before conductReview
  // can move off PENDING (enforced in clearSitting/referSitting, not by a
  // DB constraint — the same discipline as every other "required before"
  // rule in this codebase). A REFERRED sitting is excluded from
  // releaseResults (rule 3) until the examinations panel resolves it
  // through some later process — this slice does not build that path.
  conductReview      ConductReview @default(PENDING)
  invigilatorFinding String?
  reviewedByStaffId  String?
  reviewedByStaff    Staff?        @relation("SittingReviewedBy", fields: [reviewedByStaffId], references: [id])
  reviewedAt         DateTime?
  referredAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers          SittingAnswer[]
  proctoringEvents ProctoringEvent[]
  certificate      Certificate?
}

// Unique (sittingId, questionId) — upsert on autosave (rule 5).
model SittingAnswer {
  id        String  @id @default(uuid())
  sittingId String
  sitting   Sitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)

  questionId String
  question   ExamQuestion @relation(fields: [questionId], references: [id])

  selectedOptionId String?
  selectedOption   ExamQuestionOption? @relation(fields: [selectedOptionId], references: [id])
  writtenAnswer    String?

  flagged    Boolean  @default(false)
  answeredAt DateTime @default(now())

  // A written answer's Mark, once it enters the Slice 05 queue as
  // MarkableKind.EXAMINATION_WRITTEN (rule 11) — the FK Slice 05's Mark
  // model left as a plain column pointing here.
  mark Mark?

  @@unique([sittingId, questionId])
}

// Evidence, never an automatic penalty (rule 9/13) — logged and shown to
// the invigilator; a human decides what it means.
model ProctoringEvent {
  id        String  @id @default(uuid())
  sittingId String
  sitting   Sitting @relation(fields: [sittingId], references: [id], onDelete: Cascade)

  kind       String // tab_blur | fullscreen_exit | reconnect | paste_blocked
  occurredAt DateTime @default(now())
  detail     Json?

  @@index([sittingId, occurredAt])
}

// ─── Slice 07: certificates, pathway, revocation & public verification ──
//
// The credential is the product — everything upstream exists to justify
// one. A Certificate is never edited, only superseded (rule 1); every
// displayed value is snapshotted at issue (rule 2) so a later programme
// rename or grade-scale edit cannot rewrite what a third party already
// verified. certificateNumber comes from a Postgres sequence per year,
// permanent and never reused, even after revocation (rule 3).

enum CertificateStatus {
  ACTIVE
  REVOKED
  SUPERSEDED
}

// Derived once at issue from ExamRegistration.enrolmentId, then stored
// (rule 4) — never re-derived. Both routes are valid credentials; this is
// a prestige signal, never a hierarchy that shames the exam-only path.
enum CredentialPathway {
  PATHWAY
  EXAMINATION_ONLY
}

model Certificate {
  id String @id @default(uuid())

  certificateNumber String @unique // LVL-CERT-2026-01188 — permanent, never reused (rule 3)

  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])

  // The examination that earned it — unique, one certificate per sitting
  // (rule 12, the idempotency guard `issueCertificate` checks first).
  sittingId String?  @unique
  sitting   Sitting? @relation(fields: [sittingId], references: [id])

  // Non-null means the candidate took the programme (rule 4) — the FK a
  // pathway certificate carries; null for an exam-only credential.
  enrolmentId String?
  enrolment   Enrolment?        @relation(fields: [enrolmentId], references: [id])
  pathway     CredentialPathway

  // Every value below is a snapshot taken at issue (rule 2) — never
  // re-read from Programme/Candidate/GradeBandDefinition afterward.
  holderName      String
  candidateNumber String?
  programmeTitle  String
  tier            ProgrammeTier
  finalPercent    Int
  band            GradeBand

  status CertificateStatus @default(ACTIVE)

  issuedAt        DateTime
  issuedByStaffId String? // null when issued automatically on release
  issuedByStaff   Staff?   @relation("CertificateIssuedBy", fields: [issuedByStaffId], references: [id])

  // The template it was printed with — never swapped when a newer
  // revision is activated (rule 9).
  templateId String
  template   CertificateTemplate @relation(fields: [templateId], references: [id])

  revokedAt        DateTime?
  revokedReason    String? // mandatory on revoke (rule 6), enforced in revokeCertificate
  revokedByStaffId String?
  revokedByStaff   Staff?    @relation("CertificateRevokedBy", fields: [revokedByStaffId], references: [id])

  // Supersession is stored in both directions, independently (rule 7) —
  // the OLD certificate's supersededById points forward to the new one;
  // the NEW certificate's replacesId points back. Both are set together
  // by reissueCertificate, never derived from one another.
  supersededById String?      @unique
  supersededBy   Certificate? @relation("CertificateSupersededBy", fields: [supersededById], references: [id])
  supersedes     Certificate? @relation("CertificateSupersededBy")

  replacesId String?      @unique
  replaces   Certificate? @relation("CertificateReplaces", fields: [replacesId], references: [id])
  replacedBy Certificate? @relation("CertificateReplaces")

  pdfAssetId String?     @unique
  pdfAsset   MediaAsset? @relation("CertificatePdf", fields: [pdfAssetId], references: [id])

  verificationCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verificationLookups VerificationLookup[]

  @@index([candidateId, status])
  @@index([programmeId, issuedAt])
}

// Never edited in place once used (rule 9) — a new revision is a new row;
// issued certificates keep the templateId they were printed with, so
// activating a later revision alters nothing already issued.
model CertificateTemplate {
  id   String @id @default(uuid())
  name String // "Lavelle certificate — 2026 revision"

  artworkAssetId String
  artworkAsset   MediaAsset @relation("CertificateArtwork", fields: [artworkAssetId], references: [id])

  appliesToTier  ProgrammeTier? // null = all tiers
  signatoryBlock String

  // Which fields overlay the artwork: name, programme and tier, band,
  // certificate ID and QR, pathway mark, issue date.
  printedFields Json

  isActive    Boolean   @default(false) // one active per tier scope
  activatedAt DateTime?

  createdByStaffId String
  createdByStaff   Staff  @relation("CertificateTemplateCreatedBy", fields: [createdByStaffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificates Certificate[]
}

// The public portal's own log — every lookup, hit or miss, hashed IP
// (rule 10: this is a public, unauthenticated endpoint, never store a raw
// IP against it).
model VerificationLookup {
  id String @id @default(uuid())

  queriedNumber String // what was typed, including misses

  certificateId String?
  certificate   Certificate? @relation(fields: [certificateId], references: [id])

  result    String // "valid" | "revoked" | "superseded" | "not_found"
  ipHash    String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([certificateId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// ─── Slice 08: support desk, notes & announcements ───────────────────────
//
// Replaces the Handoff-era ContactRequest/AdminNote placeholders wholesale
// — nothing in the app read or wrote either one yet, and Slice 08's real
// spec needs a genuine threaded conversation (SupportMessage), which the
// placeholder's single `message` field couldn't represent at all.

enum RequestCategory {
  ENROLMENT
  PAYMENT
  TECHNICAL
  PROGRAMME
  ENQUIRY // Slice 09: a public marketing-site contact enquiry, not raised by a signed-in candidate
  OTHER
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// Slice 10: each state carries a stated response expectation in the UI
// copy (five working days / one working day / four hours) — never a
// bare label (README B5 rule 4).
enum RequestPriority {
  LOW
  NORMAL
  URGENT
}

// Slice 09: candidateId is nullable because a marketing-site enquiry
// (submitEnquiry) has no candidate account to attach to — the visitor is
// anonymous. guestName/guestEmail carry the enquirer's own details for
// that case so the desk can still show who to reply to; both stay null
// for every candidate-raised request, where candidate.* is authoritative.
model SupportRequest {
  id          String     @id @default(uuid())
  candidateId String?    @db.Uuid
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  guestName   String?
  guestEmail  String?

  subject  String
  category RequestCategory
  body     String

  status   RequestStatus   @default(OPEN)
  priority RequestPriority @default(NORMAL)

  assignedStaffId   String?
  assignedStaff     Staff?    @relation("SupportRequestAssignedTo", fields: [assignedStaffId], references: [id])
  // Slice 10: who assigned it — separate from assignedStaffId (who it's
  // assigned TO) because the two-key resolution rule needs both:
  // assignee or assigner may resolve it, nobody else.
  assignedByStaffId String?
  assignedByStaff   Staff?    @relation("SupportRequestAssignedBy", fields: [assignedByStaffId], references: [id])
  assignedAt        DateTime?
  assignmentNote    String?

  resolvedByStaffId String?
  resolvedByStaff   Staff?  @relation("SupportRequestResolvedBy", fields: [resolvedByStaffId], references: [id])

  // Set on the first SupportMessage with a non-null authorStaffId — an
  // admin-overview KPI ("support requests unanswered over 24h") reads
  // this rather than re-deriving it from the thread every time.
  firstRespondedAt DateTime?
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]
  enquiry  ContactEnquiry?

  @@index([status])
  @@index([candidateId])
}

// The thread. Exactly one of authorStaffId/authorCandidateId is set —
// enforced in application code (a raw CHECK constraint would need a
// migration-only addition Prisma can't express; the same discipline this
// project already uses for a handful of other XOR-shaped columns).
model SupportMessage {
  id        String         @id @default(uuid())
  requestId String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  authorStaffId     String?
  authorStaff       Staff?     @relation(fields: [authorStaffId], references: [id])
  authorCandidateId String?    @db.Uuid
  authorCandidate   Candidate? @relation(fields: [authorCandidateId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

// Internal only — never candidate-visible, never deleted or edited (a
// correction is a new note, not a mutation of this one).
model CandidateNote {
  id          String    @id @default(uuid())
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  authorStaffId String
  authorStaff   Staff  @relation(fields: [authorStaffId], references: [id])

  body String

  createdAt DateTime @default(now())

  @@index([candidateId, createdAt])
}

enum AnnouncementState {
  DRAFT
  SCHEDULED
  SENT
  WITHDRAWN
}

enum Channel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

model Announcement {
  id    String @id @default(uuid())
  title String
  body  String

  // Programme, intake, cohort, tier, status — shape is UI-defined, not
  // fixed by this schema; previewAudience/sendAnnouncement interpret it.
  audienceFilter Json

  channels Channel[]
  state    AnnouncementState @default(DRAFT)

  scheduledFor DateTime?
  sentAt       DateTime?

  // Resolved once, at send, then frozen (rule 8) — re-resolving the
  // filter later would give a different answer and make "who received
  // this" unanswerable. The delivery rows are the actual record; this
  // is the fast-read summary of them.
  recipientCount Int?

  createdByStaffId String
  createdByStaff   Staff  @relation(fields: [createdByStaffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries AnnouncementDelivery[]

  @@index([state, scheduledFor])
}

// One row per recipient per channel (rule 8) — a candidate on two
// channels gets two rows, so "did this candidate receive it, and how"
// always has a concrete answer.
model AnnouncementDelivery {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  candidateId    String       @db.Uuid
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  channel Channel

  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?

  @@unique([announcementId, candidateId, channel])
  @@index([announcementId])
}

// ─── Audit ───────────────────────────────────────────────────────────────

// Append-only by contract (Handoff 01): the application DB role holds only
// INSERT and SELECT on this table — see prisma/migrations/*_audit_grants
// for the REVOKE. subjectId/actorStaffId stay plain String (not @db.Uuid):
// this table is polymorphic across subjects that are genuinely uuid
// (Candidate) and subjects that are still cuid-keyed from the foundation
// schema (Staff, Certificate, Payment, Question, ...) — a strict uuid
// column would reject the latter. Documented as a spec deviation.
model AuditEvent {
  id BigInt @id @default(autoincrement())

  actorStaffId String?
  actor        Staff?  @relation(fields: [actorStaffId], references: [id])

  subjectType String  @db.VarChar(40) // "candidate", "certificate", "payment", "staff", "question", …
  subjectId   String
  action      String  @db.VarChar(80) // "candidate.suspended", "candidate.reactivated", …
  description String // the human-readable label the audit log renders
  reason      String? // mandatory for destructive actions — enforced per action, not by column
  ipAddress   String? @db.Inet

  createdAt DateTime @default(now())

  @@index([subjectType, subjectId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_event")
}

// ─── Rate limiting ───────────────────────────────────────────────────────

// Fixed-window counter, Postgres-backed so it survives serverless (an
// in-memory limiter does not). Keyed by an arbitrary bucket string, e.g.
// "register:ip:203.0.113.4" or "signIn:email:c.okonji@chambers.ng" — see
// src/lib/rate-limit.ts.
model RateLimitAttempt {
  id          BigInt   @id @default(autoincrement())
  bucketKey   String
  windowStart DateTime
  count       Int      @default(1)

  @@unique([bucketKey, windowStart])
}

// ─── Slice 09: public website & publishing ─────────────────────────────
//
// Deliberately separate from Programme (rule 1): a programme can be
// ACTIVE for enrolment while unlisted publicly, and a listing can be
// edited without touching the syllabus. If these were one row,
// unpublishing from the site would silently close enrolment.

model ProgrammeListing {
  id String @id @default(uuid())

  programmeId String    @unique
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  isPublished Boolean @default(false)
  // When true the listing renders from the live Programme row (rule 2:
  // defaults are computed, never copied, so a fee change reaches the
  // site without republishing). When false, every override field below
  // must be filled before publishing (checked in publishListing).
  useDefaults Boolean @default(true)

  headline       String? // overrides Programme.title
  summary        String? // overrides Programme.summary
  outcomes       Json? // "What you will be able to do" — string[]
  includes       Json? // "What enrolment includes" — string[]
  assessmentNote String?
  paymentNote    String?

  heroAssetId String?
  heroAsset   MediaAsset? @relation(fields: [heroAssetId], references: [id])

  // The public page's preview video. When true, it's the same clip
  // already recorded for the candidate-facing catalogue
  // (Programme.coverVideoUrl/coverVideoAsset) — resolved fresh on every
  // read, same "computed not copied" rule as useDefaults above, so
  // re-recording the cover video reaches the site with no republish.
  // When false, videoUrl/videoAsset below is a website-only override.
  useCoverVideo Boolean     @default(true)
  videoUrl      String?
  videoAssetId  String?
  videoAsset    MediaAsset? @relation("ListingVideo", fields: [videoAssetId], references: [id])

  orderIndex Int @default(0)

  publishedAt        DateTime?
  publishedByStaffId String?
  publishedByStaff   Staff?    @relation("ListingPublishedBy", fields: [publishedByStaffId], references: [id])
  unpublishedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, orderIndex])
}

// Slice 11 Part D: three states, not two — a DECLINED review and one
// nobody has looked at yet are different things, and the queue is
// unusable if they collapse together. Replaces isPublished (migrated
// true -> PUBLISHED, false -> PENDING, then dropped).
enum ReviewState {
  PENDING
  PUBLISHED
  DECLINED
}

// Real attributions only (rule 11) — an invented name is a legal risk in
// a market this small, where people know each other.
model Review {
  id String @id @default(uuid())

  // Slice 11 Part D: nullable — Slice 09 seeded marketing testimonials
  // with no real submitter behind them; a genuine submission (submitReview,
  // gated on a COMPLETED enrolment) sets both. authorName/authorTitle stay
  // the display copy either way, populated from the candidate at
  // submission time for a real review.
  candidateId String?    @db.Uuid
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  enrolmentId String?
  enrolment   Enrolment? @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)

  authorName  String
  authorTitle String // "Partner, energy practice, Lagos"

  programmeId String?
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)

  quote  String
  rating Int // 1-5

  state              ReviewState @default(PENDING)
  moderatedByStaffId String?
  moderatedByStaff   Staff?      @relation("ReviewModeratedBy", fields: [moderatedByStaffId], references: [id])
  moderatedAt        DateTime?
  // Internal only — never shown to the candidate (rule 7); the
  // conversation about a declined review belongs in support.
  declineReason      String?

  orderIndex Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, orderIndex])
}

model FaqEntry {
  id String @id @default(uuid())

  question String
  answer   String

  // Explicit, not alphabetical or creation-order — "Do I need to pay to
  // register?" is deliberately first and the prerequisite question is
  // deliberately last.
  orderIndex Int

  isPublished Boolean @default(true)

  @@index([isPublished, orderIndex])
}

// Content-marketing posts, shown on the public website (/blog) and inside
// the signed-in candidate portal (/portal/blog) — the same published rows,
// since a post has no candidate-specific or payment-gated content (unlike
// the Catalogue). Mirrors ProgrammeListing's publish/unpublish shape.
model BlogPost {
  id   String @id @default(uuid())
  slug String @unique

  title   String
  excerpt String
  // Rich-text markup (src/lib/rich-text.ts) — never HTML, same rule as
  // LectureNote.body. Rendered read-only via renderMarkupToReact.
  body String
  tags Json // string[], same Json-array convention as ProgrammeListing.outcomes/includes

  // Free-text byline — defaults to the writing staff member's name at
  // creation but is editable independently of who actually wrote it.
  authorName String

  heroAssetId String?
  heroAsset   MediaAsset? @relation(fields: [heroAssetId], references: [id])

  isPublished        Boolean   @default(false)
  publishedAt        DateTime?
  publishedByStaffId String?
  publishedByStaff   Staff?    @relation("BlogPostPublishedBy", fields: [publishedByStaffId], references: [id])
  unpublishedAt      DateTime?

  createdByStaffId String
  createdByStaff   Staff  @relation("BlogPostCreatedBy", fields: [createdByStaffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ordering is chronological (publishedAt desc), not a manual orderIndex
  // like the curated FaqEntry/ProgrammeListing — nobody hand-orders a feed.
  @@index([isPublished, publishedAt(sort: Desc)])
}

// Lands in the Slice 08 support desk as a SupportRequest with no
// candidateId (see that model's comment) — a form that posts into a void
// is worse than no form.
model ContactEnquiry {
  id String @id @default(uuid())

  name  String
  email String
  phone String?

  // Options come from published listings only (rule 7) — never a
  // hardcoded list that drifts. Null means "not sure yet, please advise".
  programmeOfInterestId String?
  programmeOfInterest   Programme? @relation(fields: [programmeOfInterestId], references: [id], onDelete: SetNull)

  message String

  supportRequestId String?         @unique
  supportRequest   SupportRequest? @relation(fields: [supportRequestId], references: [id], onDelete: SetNull)

  handledByStaffId String?
  handledByStaff   Staff?    @relation("EnquiryHandledBy", fields: [handledByStaffId], references: [id])
  handledAt        DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
}
