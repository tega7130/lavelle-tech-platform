// Lavelle — domain model.
// Vocabulary, entities and state machines are binding per the design
// handoff READMEs: candidate/programme/module/lecture/enrolment/cohort/
// intake/credit/applicant/registrar/faculty. Never "student" or "course".
//
// The candidate/session/audit tables below are a literal contract from
// Handoff 01's README — column names, types, nullability and indexes are
// kept verbatim because later slices reference them by name. See that
// README for the authoritative spec; deviations are called out inline.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, citext]
}

// ─── Candidate ───────────────────────────────────────────────────────────

// practising_lawyer | inhouse_counsel | law_graduate | law_student | regulated_non_lawyer | other
enum ProfessionalStatus {
  PRACTISING_LAWYER
  INHOUSE_COUNSEL
  LAW_GRADUATE
  LAW_STUDENT
  REGULATED_NON_LAWYER
  OTHER
}

// 0_2 | 3_5 | 6_10 | 10_plus — Prisma enum identifiers can't start with a
// digit, so the DB-level label is pinned with @map and the Prisma-side name
// is just a valid spelling of it.
enum ExperienceBand {
  Y0_2     @map("0_2")
  Y3_5     @map("3_5")
  Y6_10    @map("6_10")
  Y10_PLUS @map("10_plus")
}

// active | suspended. Deliberately NOT applicant/enrolled — is_enrolled is
// derived from candidate_number IS NOT NULL, never stored (Handoff 01 rule 1).
enum CandidateAccountStatus {
  ACTIVE
  SUSPENDED
}

model Candidate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Issued at registration, permanent, never reused (LVL-APP-2026-04412).
  applicantNumber String  @unique @db.VarChar(24)
  // Null until first confirmed payment (LVL/2026/00291) — a second,
  // separate identifier from applicantNumber, never derived from it.
  candidateNumber String? @unique @db.VarChar(24)

  firstName       String    @db.VarChar(80)
  lastName        String    @db.VarChar(80)
  // citext — case-insensitive uniqueness/lookup is the point, not just storage.
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime?

  phoneCountryCode String  @default("+234") @db.VarChar(6)
  phone            String? @db.VarChar(24)

  passwordHash String

  acceptedTermsAt DateTime
  marketingOptIn  Boolean  @default(false)

  accountStatus   CandidateAccountStatus @default(ACTIVE)
  suspendedAt     DateTime?
  suspendedReason String?
  reactivatedAt   DateTime?

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile                 CandidateProfile?
  emailVerificationTokens EmailVerificationToken[]
  notifications           Notification[]
  sessions                Session[]
  enrolments              Enrolment[]
  payments                Payment[]
  idCards                 IdCard[]
  certificates            Certificate[]
  examinationSittings     ExaminationSitting[]
  contactRequests         ContactRequest[]
  adminNotes              AdminNote[]

  @@index([accountStatus])
}

// One-to-one, all nullable — the profile-completion modal's output. Which
// conditional fields apply is decided by professionalStatus (see
// src/lib/onboarding.ts); enforced in the Zod schema, not only the UI.
model CandidateProfile {
  candidateId String    @id @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  professionalStatus ProfessionalStatus?
  yearOfCall         Int?                @db.SmallInt // lawyers only, 1960 <= n <= current year
  scnNumber          String?             @db.VarChar(24) // lawyers only
  institution        String?             @db.VarChar(160) // graduates/students
  graduationYear     Int?                @db.SmallInt // graduates/students
  organisation       String?             @db.VarChar(160) // regulated/other
  roleTitle          String?             @db.VarChar(120) // regulated/other
  experienceBand     ExperienceBand?
  placeOfPractice    String?             @db.VarChar(160)
  photoUrl           String?

  handbookAcknowledgedAt DateTime? // checklist step 5
  completedAt            DateTime? // set when the 3-step modal finishes
}

model EmailVerificationToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Store the hash, send the plaintext — never store a usable token.
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([candidateId, consumedAt])
}

enum NotificationCategory {
  ACCOUNT
  CREDENTIAL
  PROGRAMME
  ASSESSMENT
  FINANCE
}

model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  category NotificationCategory
  title    String               @db.VarChar(160)
  body     String
  readAt   DateTime?

  createdAt DateTime @default(now())

  @@index([candidateId, createdAt(sort: Desc)])
}

// Database-backed candidate sessions — deliberately NOT a stateless JWT.
// Suspending an account revokes every live session immediately, which a
// self-contained token can't do. Read via a cached getCurrentCandidate()
// (src/lib/candidate-session.ts): revokedAt IS NOT NULL or
// accountStatus = SUSPENDED both mean signed out. Cookie carries the
// opaque plaintext token; only its hash is ever persisted.
model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime

  revokedAt DateTime? // set on logout, on suspension, on password change
  userAgent String?
  ipAddress String?   @db.Inet

  createdAt DateTime @default(now())

  @@index([candidateId, revokedAt])
}

// ─── Staff, roles & permissions ─────────────────────────────────────────

enum StaffRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  FINANCE_ADMIN
  ACADEMIC_ADMIN
  FACULTY
  SUPPORT_AGENT
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

// The 17-permission catalogue, six categories, per the README table.
enum Permission {
  VIEW_CANDIDATES
  EDIT_CANDIDATES
  VIEW_CONTACT_REQUESTS
  RESOLVE_CONTACT_REQUESTS
  ADD_ADMIN_NOTES
  VIEW_PAYMENTS
  MANAGE_PAYMENTS
  VIEW_GRADES
  GRADE_ASSESSMENTS
  MANAGE_PROGRAMMES
  MANAGE_INTAKES
  ISSUE_CERTIFICATES
  REVOKE_CERTIFICATES
  VIEW_AUDIT_LOG
  EXPORT_DATA
  MANAGE_STAFF
  SUPER_ADMIN
}

model Staff {
  id String @id @default(cuid())

  name       String
  email      String  @unique // the login
  phone      String?
  jobTitle   String?
  department String?

  lineManagerId String?
  lineManager   Staff?  @relation("StaffReports", fields: [lineManagerId], references: [id])
  reports       Staff[] @relation("StaffReports")

  role   StaffRole
  status StaffStatus @default(ACTIVE)

  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissionGrants PermissionGrant[]

  auditEvents             AuditEvent[]
  resolvedContactRequests ContactRequest[] @relation("ContactRequestResolvedBy")
  adminNotesAuthored      AdminNote[]
  revokedCertificates     Certificate[]    @relation("CertificateRevokedBy")
  createdProgrammes       Programme[]      @relation("ProgrammeCreatedBy")
  uploadedMediaAssets     MediaAsset[]
  confirmedPayments       Payment[]        @relation("PaymentConfirmedBy")
  facultyLeadCohorts      Cohort[]         @relation("CohortFacultyLead")

  @@index([role])
  @@index([status])
}

// Explicit per-staff permission set. Seeded from the role's preset on
// creation or when a preset is (re-)applied; individual toggles update
// rows here directly and save immediately (README: "toggling saves
// immediately and writes to the audit log"). super_admin's SUPER_ADMIN
// grant bypasses every other check — see src/lib/permissions.ts.
model PermissionGrant {
  id         String     @id @default(cuid())
  staffId    String
  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  permission Permission
  granted    Boolean    @default(true)
  updatedAt  DateTime   @updatedAt

  @@unique([staffId, permission])
}

// ─── Programme, module, lecture ─────────────────────────────────────────
//
// The deepest schema in the system (Handoff Slice 02) — column names and
// types kept verbatim from that README because the catalogue, course
// player, quizzes, exam question bank and certificates all read this.
// Nothing here is candidate-facing.

enum ProgrammeTier {
  FOUNDATION
  SPECIALIST
  ADVANCED_PRACTITIONER
}

// DRAFT is the authoring state. ACTIVE means open for enrolment — it is
// NOT website publication (a separate flag Slice 09 adds); a programme
// can be ACTIVE and unpublished on the marketing site at the same time.
// Conflating the two would make unpublishing silently close enrolment.
enum ProgrammeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Administrators pick an existing category or create one inline while
// authoring. Case-insensitive dedupe on `name` happens in the service
// (createCategory), not here — Postgres citext would also work but the
// spec gives a plain unique String, so the dedupe check stays app-side.
model ProgrammeCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programmes Programme[]
}

model Programme {
  id    String @id @default(uuid())
  code  String @unique // e.g. ELR-201 — immutable once any enrolment exists (rule 3)
  title String

  categoryId String
  category   ProgrammeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  tier   ProgrammeTier
  status ProgrammeStatus @default(DRAFT)

  summary String // the paragraph shown in the catalogue and public listing

  weeks            Int // 8 Foundation · 12 Specialist · 16 Advanced — stored, never derived from tier
  weeklyHoursLabel String // free text range, e.g. "6–8 hrs / week" — a label, not a number
  credits          Int // Lavelle credits — never "CPD points"

  feeMinor Int // naira KOBO, integer minor units — ₦450,000 is 45000000. Never a float.
  currency String @default("NGN")

  deliveryLabel    String         @default("Online + proctored exam")
  prerequisiteTier ProgrammeTier? // non-null only for ADVANCED_PRACTITIONER; Slice 06 enforces it

  createdByStaffId String
  createdBy        Staff  @relation("ProgrammeCreatedBy", fields: [createdByStaffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules              Module[]
  assessmentWeightings AssessmentWeighting[]
  cohorts              Cohort[]
  enrolments           Enrolment[]
  // No direct payments relation — Payment references Enrolment, not
  // Programme, directly (see the README's Payment table); go through
  // enrolment.programme to reach a payment's programme.
  certificates         Certificate[]
  examination          Examination?

  @@index([status, tier])
  @@index([categoryId])
}

model Module {
  id          String    @id @default(uuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  weekNumber Int // 1-based
  title      String
  summary    String?

  // How many approved objective questions this module contributes to the
  // certifying examination. Slice 06 reads it and blocks publishing an
  // examination while a module has fewer approved questions than this —
  // this slice only stores the number, it does not enforce that check.
  examQuestionDraw Int @default(2)

  // Explicit ordering, independent of weekNumber — reordering must not
  // renumber weeks (rule 9).
  orderIndex Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lectures  Lecture[]
  questions Question[] // the Slice 00 exam question bank — a different table from Quiz below, see that model's comment
  quiz      Quiz?

  @@unique([programmeId, weekNumber])
  @@index([programmeId, orderIndex])
}

enum LectureMediaKind {
  SLIDES
  VIDEO
}

// NONE — no audio.
// PER_SLIDE — each slide carries its own narrationAssetId; narrationAutoAdvance
//   decides whether finishing it advances the slide.
// FULL_LECTURE — one fullNarrationAssetId for the whole lecture;
//   narrationAutoAdvance is meaningless there and must be stored false.
enum NarrationMode {
  NONE
  PER_SLIDE
  FULL_LECTURE
}

model Lecture {
  id       String @id @default(uuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  orderIndex Int
  title      String

  mediaKind LectureMediaKind
  videoUrl  String? // video only — a pasted hosted URL; nothing to probe, duration shows "pending"

  // Not in the README's literal table — added because the duration rule
  // ("...or the video's duration") is only achievable for a video that
  // was actually uploaded (and so has bytes to probe), as distinct from
  // videoUrl above (a pasted URL, where there is genuinely nothing to
  // probe and "Duration pending" is correct, not a gap).
  // Not @unique — a MediaAsset can be referenced by more than one lecture
  // (duplicateProgramme shares uploaded bytes by reference rather than
  // copying them; nothing in the README requires strict 1:1 either).
  videoAssetId String?
  videoAsset   MediaAsset? @relation("LectureVideo", fields: [videoAssetId], references: [id])

  narrationMode        NarrationMode @default(NONE)
  narrationAutoAdvance Boolean       @default(false) // only meaningful when PER_SLIDE
  narrationRequireFull Boolean       @default(false) // must the candidate hear a slide out before advancing

  fullNarrationAssetId String? // only when FULL_LECTURE
  fullNarrationAsset   MediaAsset? @relation("LectureFullNarration", fields: [fullNarrationAssetId], references: [id])

  scenarioPrompt   String? // the applied-scenario step
  scenarioGuidance String?

  draftingPrompt    String? // the faculty-marked drafting exercise
  draftingWordLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slides Slide[]

  @@index([moduleId, orderIndex])
}

model Slide {
  id        String  @id @default(uuid())
  lectureId String
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  orderIndex Int
  title      String?
  body       String? // markdown

  imageAssetId String?
  imageAsset   MediaAsset? @relation("SlideImage", fields: [imageAssetId], references: [id])

  narrationAssetId String? // the per-slide audio
  narrationAsset   MediaAsset? @relation("SlideNarration", fields: [narrationAssetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lectureId, orderIndex])
}

// One table for every upload — narration audio, slide images, lecture
// video, certificate artwork. storageKey is an object-storage key, never
// a public URL — content is only ever reachable through a signed,
// expiring URL (rule 10). durationSeconds is required for audio/video and
// is probed server-side on upload (src/lib/uploads.ts); a lecture's
// estimated duration is always derived by summing these, never entered.
model MediaAsset {
  id String @id @default(uuid())

  kind       String // "audio" | "image" | "video" | "document"
  storageKey String @unique
  mimeType   String
  bytes      Int

  durationSeconds Int? // required for audio/video, probed not trusted from the client

  originalFilename String

  uploadedByStaffId String
  uploadedBy        Staff  @relation(fields: [uploadedByStaffId], references: [id])

  createdAt DateTime @default(now())

  // Arrays, not single relations — not @unique on the FK side above, so a
  // MediaAsset can be shared by more than one lecture/slide.
  lectureFullNarrations Lecture[] @relation("LectureFullNarration")
  lectureVideos         Lecture[] @relation("LectureVideo")
  slideImages           Slide[]   @relation("SlideImage")
  slideNarrations       Slide[]   @relation("SlideNarration")
  receiptForPayments    Payment[] @relation("PaymentReceipt")
  idCardPhotos          IdCard[]  @relation("IdCardPhoto")
}

// Module-close quizzes — auto-marked and formative. NOT the examination
// question bank (a different table Slice 06 owns): a quiz question is
// drawn from nowhere and always shown; an examination question is drawn,
// shuffled, and summative. Do not conflate them.
model Quiz {
  id       String @id @default(uuid())
  moduleId String @unique
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  passMarkPercent Int @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions QuizQuestion[]
}

model QuizQuestion {
  id     String @id @default(uuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  orderIndex  Int
  prompt      String
  marks       Int     @default(1)
  explanation String? // shown after marking

  options QuizOption[]

  @@index([quizId, orderIndex])
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  orderIndex Int
  text       String
  // Exactly one true per question — enforced in the service (upsertQuiz), not by a DB constraint.
  isCorrect  Boolean @default(false)

  @@index([questionId, orderIndex])
}

enum AssessmentKind {
  QUIZ
  DRAFTING
  EXAMINATION
}

// The 20/40/40 split is a property of the programme, not a constant in
// code. The three weights must total exactly 100 — validated on write
// (upsertAssessmentWeighting), because Slice 05 computes a final mark
// from whatever is stored here regardless.
model AssessmentWeighting {
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  kind          AssessmentKind
  weightPercent Int

  @@id([programmeId, kind])
}

// ─── Intake, cohort, enrolment ──────────────────────────────────────────

// ─── Slice 03: catalogue, payment & enrolment ───────────────────────────
//
// This is the slice where an applicant becomes a candidate. Column names,
// types and indexes are kept verbatim from that README — the enrolment
// transaction, the webhook handler and the offline-recording action all
// depend on this exact shape. Deviations are called out inline.

enum IntakeMonth {
  JANUARY
  APRIL
  SEPTEMBER
}

enum IntakeStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model Intake {
  id     String       @id @default(uuid())
  month  IntakeMonth
  year   Int
  status IntakeStatus @default(OPEN)

  enrolmentOpensAt  DateTime
  enrolmentClosesAt DateTime
  startsAt          DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohorts             Cohort[]
  examinationSittings ExaminationSitting[]
  enrolments          Enrolment[]

  @@unique([month, year])
}

model Cohort {
  id          String    @id @default(uuid())
  code        String    @unique // e.g. "SPEC-ENR-03"
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  intakeId    String
  intake      Intake    @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  capacity Int

  facultyLeadStaffId String?
  facultyLead        Staff?  @relation("CohortFacultyLead", fields: [facultyLeadStaffId], references: [id])

  // OPEN | FULL | IN_PROGRESS | COMPLETED — a plain string per the README
  // (not an enum), so a new operational state doesn't need a migration.
  status String @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrolments Enrolment[]

  @@index([programmeId, intakeId])
}

// PENDING_PAYMENT -> ACTIVE -> COMPLETED, or -> WITHDRAWN | REFUNDED.
// WITHDRAWN/REFUNDED are the only statuses a candidate can hold two live
// rows around for the same programme (see the partial unique index below)
// — re-enrolment after leaving is allowed.
enum EnrolmentStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  WITHDRAWN
  REFUNDED
}

model Enrolment {
  id          String    @id @default(uuid())
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])
  // Assigned on confirmation (enrolment transaction step 5) — null until then.
  cohortId    String?
  cohort      Cohort?   @relation(fields: [cohortId], references: [id])
  intakeId    String
  intake      Intake    @relation(fields: [intakeId], references: [id])

  // Business rule 1: this record's existence at ACTIVE, and the cohort
  // placement, follow confirmed payment — never acceptance, never an
  // admin flag.
  status EnrolmentStatus @default(PENDING_PAYMENT)

  enrolledAt   DateTime? // set when status becomes ACTIVE — i.e. on payment confirmation
  completedAt  DateTime? // a later slice sets this
  withdrawnAt  DateTime?
  refundedAt   DateTime?
  // Required for WITHDRAWN and REFUNDED; written to the audit log.
  statusReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  // Partial unique index — a candidate cannot hold two live enrolments in
  // the same programme, but may re-enrol after withdrawing. Prisma cannot
  // express a WHERE clause on a unique index, so this is written as raw
  // SQL in the migration (enrolment_one_live_per_programme) and is not
  // enforced by this @@index declaration alone.
  @@index([candidateId, status])
  @@index([cohortId, status])
  @@index([programmeId])
}

// ─── Payments ────────────────────────────────────────────────────────────

enum PaymentPurpose {
  PROGRAMME_FEE
  EXAMINATION_FEE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// Bank transfer, cash at a branch, a POS terminal, or a cheque — recorded
// by a finance officer once cleared, never a candidate self-report.
enum OfflinePaymentMode {
  BANK_TRANSFER
  CASH_DEPOSIT
  POS_TERMINAL
  CHEQUE
}

model Payment {
  id          String    @id @default(uuid())
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  purpose              PaymentPurpose
  enrolmentId          String? // null for an examination fee
  enrolment            Enrolment?          @relation(fields: [enrolmentId], references: [id])
  // The README's table names this examRegistrationId for a not-yet-built
  // Slice 06 model — this codebase already has ExaminationSitting serving
  // exactly that role (an existing, tested FK), so it is reused here
  // rather than inventing a second, still-hypothetical model.
  examinationSittingId String?
  examinationSitting   ExaminationSitting? @relation(fields: [examinationSittingId], references: [id])

  // Kobo. A snapshot of the fee at the time of payment — never read the
  // live programme fee when displaying a historic payment (rule 7).
  amountMinor Int
  currency    String        @default("NGN")
  status      PaymentStatus @default(PENDING)

  provider          String // "paystack" | "flutterwave" | "bank_transfer"
  providerReference String? @unique // the provider's transaction reference
  // Ours — shown to the candidate and quoted in support, e.g. LVL-PAY-2026-11842.
  internalReference String  @unique

  initiatedAt   DateTime  @default(now())
  confirmedAt   DateTime?
  failedAt      DateTime?
  failureReason String? // provider message, sanitised for display

  // Non-null only for a manual confirmation (webhook confirmations leave
  // this null) — the audit trail for the highest-risk admin action.
  confirmedByStaffId     String?
  confirmedByStaff       Staff?  @relation("PaymentConfirmedBy", fields: [confirmedByStaffId], references: [id])
  manualConfirmationNote String? // mandatory when confirmedByStaffId is set

  // Non-null only for an offline recording.
  offlineMode         OfflinePaymentMode?
  offlineReference    String? // bank transaction reference, teller slip no., terminal reference, or cheque no.
  // The date the money actually arrived — NOT confirmedAt. A transfer
  // received on the 6th may be recorded on the 8th, and the ledger
  // reconciles against this column, not confirmedAt.
  offlineReceivedOn   DateTime?
  // Mandatory for an offline recording — held on the record permanently.
  receiptAssetId      String?
  receiptAsset        MediaAsset?         @relation("PaymentReceipt", fields: [receiptAssetId], references: [id])
  // Stamped when the finance officer ticks "I have verified this payment
  // against the bank statement" — the moment they take responsibility.
  statementVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId, createdAt(sort: Desc)])
  // Drives the "pending over 48 hours" alert.
  @@index([status, initiatedAt])
}

// Idempotency for provider callbacks — without this table a retried
// webhook enrols twice. Insert before processing; a duplicate insert
// (the unique constraint below) means already handled: return 200 and do
// nothing.
model WebhookEvent {
  id              String  @id @default(uuid())
  provider        String
  providerEventId String
  payload         Json // the raw body, stored verbatim
  signatureValid  Boolean

  processedAt DateTime? // null means received but not yet applied
  receivedAt  DateTime  @default(now())

  @@unique([provider, providerEventId])
}

// Issued on payment confirmation, never on acceptance (rule 3). Only one
// card per candidate has retiredAt IS NULL — reissue retires the current
// one and creates a successor via reissuedFromId, so the history stays
// legible.
model IdCard {
  id          String    @id @default(uuid())
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  cardNumber String        @unique // matches the candidate number
  tier       ProgrammeTier // the highest tier the candidate holds

  issuedAt   DateTime
  validUntil DateTime
  retiredAt  DateTime?

  reissuedFromId String? @unique
  reissuedFrom   IdCard? @relation("IdCardReissue", fields: [reissuedFromId], references: [id])
  reissuedTo     IdCard? @relation("IdCardReissue")

  photoAssetId String?
  photoAsset   MediaAsset? @relation("IdCardPhoto", fields: [photoAssetId], references: [id])

  createdAt DateTime @default(now())

  @@index([candidateId])
}

// ─── Assessment: question bank & examination ────────────────────────────

enum QuestionType {
  MCQ
  THEORY
}

enum QuestionDifficulty {
  STANDARD
  TESTING
  ADVANCED
}

// Business rule 8/9: retiring withdraws a question from future draws but
// preserves the record and can be restored; editing applies to future
// sittings only.
enum QuestionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED
}

model Question {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  type       QuestionType
  text       String
  marks      Int
  difficulty QuestionDifficulty?
  minWords   Int? // theory only
  guidance   String? // theory only — marking guidance, not shown to candidates

  status    QuestionStatus @default(DRAFT)
  retiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId, status])
}

model Examination {
  id          String    @id @default(cuid())
  programmeId String    @unique
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  feeNaira        Decimal @db.Decimal(12, 2)
  durationMinutes Int
  passMarkPct     Int     @default(60)
  attemptsPolicy  String  @default("One resit on referral")

  proctored Boolean @default(true)
  remote    Boolean @default(true)

  fullscreenRequired Boolean @default(true)
  tabSwitchWarning   Boolean @default(true)
  shuffleQuestions   Boolean @default(true)
  shuffleOptions     Boolean @default(false)
  reviewAllowed      Boolean @default(true)

  // Business rule 6: publishing is blocked while any module is short on
  // approved objective questions for its draw count.
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sittings ExaminationSitting[]
}

// registered -> sat -> passed | referred
//            -> forfeited (on quit)
enum SittingStatus {
  REGISTERED
  SAT
  PASSED
  REFERRED
  FORFEITED
}

model ExaminationSitting {
  id            String      @id @default(cuid())
  examinationId String
  examination   Examination @relation(fields: [examinationId], references: [id])
  candidateId   String      @db.Uuid
  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  intakeId      String
  intake        Intake      @relation(fields: [intakeId], references: [id])

  status SittingStatus @default(REGISTERED)

  registeredAt  DateTime  @default(now())
  satAt         DateTime?
  // Weighted composite per business rule 7: quizzes 20%, drafting 40%,
  // examination 40%. Grade bands: Distinction / Merit / Pass / Refer.
  finalScorePct Decimal?  @db.Decimal(5, 2)
  grade         Grade?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([status])
}

enum Grade {
  DISTINCTION
  MERIT
  PASS
  REFER
}

// ─── Certificates ────────────────────────────────────────────────────────

// active -> revoked (mandatory reason, audit-logged)
// active -> reissued (creates a NEW identifier; the previous one is retired)
enum CertificateStatus {
  ACTIVE
  REVOKED
}

model Certificate {
  id         String @id @default(cuid())
  identifier String @unique // e.g. LVL-CERT-2026-01188

  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])

  tier  ProgrammeTier
  grade Grade

  issuedAt DateTime          @default(now())
  status   CertificateStatus @default(ACTIVE)

  revokedReason    String?
  revokedAt        DateTime?
  revokedByStaffId String?
  revokedBy        Staff?    @relation("CertificateRevokedBy", fields: [revokedByStaffId], references: [id])

  // Reissue chain — course access is unaffected by revocation (README);
  // only the credential document itself is retired/replaced.
  replacesCertificateId String?      @unique
  replaces              Certificate? @relation("CertificateReissue", fields: [replacesCertificateId], references: [id])
  supersededBy          Certificate? @relation("CertificateReissue")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([status])
}

// ─── Support ─────────────────────────────────────────────────────────────

enum ContactRequestStatus {
  OPEN
  RESOLVED
}

model ContactRequest {
  id          String    @id @default(cuid())
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  category String
  subject  String
  message  String

  status            ContactRequestStatus @default(OPEN)
  resolvedByStaffId String?
  resolvedBy        Staff?               @relation("ContactRequestResolvedBy", fields: [resolvedByStaffId], references: [id])
  resolvedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Internal notes on a candidate profile — distinct from contact-request
// resolution; gated by its own permission (add_admin_notes).
model AdminNote {
  id          String    @id @default(cuid())
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  staffId     String
  staff       Staff     @relation(fields: [staffId], references: [id])

  note String

  createdAt DateTime @default(now())

  @@index([candidateId])
}

// ─── Audit ───────────────────────────────────────────────────────────────

// Append-only by contract (Handoff 01): the application DB role holds only
// INSERT and SELECT on this table — see prisma/migrations/*_audit_grants
// for the REVOKE. subjectId/actorStaffId stay plain String (not @db.Uuid):
// this table is polymorphic across subjects that are genuinely uuid
// (Candidate) and subjects that are still cuid-keyed from the foundation
// schema (Staff, Certificate, Payment, Question, ...) — a strict uuid
// column would reject the latter. Documented as a spec deviation.
model AuditEvent {
  id BigInt @id @default(autoincrement())

  actorStaffId String?
  actor        Staff?  @relation(fields: [actorStaffId], references: [id])

  subjectType String  @db.VarChar(40) // "candidate", "certificate", "payment", "staff", "question", …
  subjectId   String
  action      String  @db.VarChar(80) // "candidate.suspended", "candidate.reactivated", …
  description String // the human-readable label the audit log renders
  reason      String? // mandatory for destructive actions — enforced per action, not by column
  ipAddress   String? @db.Inet

  createdAt DateTime @default(now())

  @@index([subjectType, subjectId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_event")
}

// ─── Rate limiting ───────────────────────────────────────────────────────

// Fixed-window counter, Postgres-backed so it survives serverless (an
// in-memory limiter does not). Keyed by an arbitrary bucket string, e.g.
// "register:ip:203.0.113.4" or "signIn:email:c.okonji@chambers.ng" — see
// src/lib/rate-limit.ts.
model RateLimitAttempt {
  id          BigInt   @id @default(autoincrement())
  bucketKey   String
  windowStart DateTime
  count       Int      @default(1)

  @@unique([bucketKey, windowStart])
}
