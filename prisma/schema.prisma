// Lavelle — domain model.
// Vocabulary, entities and state machines are binding per the design
// handoff READMEs: candidate/programme/module/lecture/enrolment/cohort/
// intake/credit/applicant/registrar/faculty. Never "student" or "course".
//
// The candidate/session/audit tables below are a literal contract from
// Handoff 01's README — column names, types, nullability and indexes are
// kept verbatim because later slices reference them by name. See that
// README for the authoritative spec; deviations are called out inline.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, citext]
}

// ─── Candidate ───────────────────────────────────────────────────────────

// practising_lawyer | inhouse_counsel | law_graduate | law_student | regulated_non_lawyer | other
enum ProfessionalStatus {
  PRACTISING_LAWYER
  INHOUSE_COUNSEL
  LAW_GRADUATE
  LAW_STUDENT
  REGULATED_NON_LAWYER
  OTHER
}

// 0_2 | 3_5 | 6_10 | 10_plus — Prisma enum identifiers can't start with a
// digit, so the DB-level label is pinned with @map and the Prisma-side name
// is just a valid spelling of it.
enum ExperienceBand {
  Y0_2     @map("0_2")
  Y3_5     @map("3_5")
  Y6_10    @map("6_10")
  Y10_PLUS @map("10_plus")
}

// active | suspended. Deliberately NOT applicant/enrolled — is_enrolled is
// derived from candidate_number IS NOT NULL, never stored (Handoff 01 rule 1).
enum CandidateAccountStatus {
  ACTIVE
  SUSPENDED
}

model Candidate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Issued at registration, permanent, never reused (LVL-APP-2026-04412).
  applicantNumber String @unique @db.VarChar(24)
  // Null until first confirmed payment (LVL/2026/00291) — a second,
  // separate identifier from applicantNumber, never derived from it.
  candidateNumber String? @unique @db.VarChar(24)

  firstName String @db.VarChar(80)
  lastName  String @db.VarChar(80)
  // citext — case-insensitive uniqueness/lookup is the point, not just storage.
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime?

  phoneCountryCode String  @default("+234") @db.VarChar(6)
  phone            String? @db.VarChar(24)

  passwordHash String

  acceptedTermsAt DateTime
  marketingOptIn  Boolean  @default(false)

  accountStatus   CandidateAccountStatus @default(ACTIVE)
  suspendedAt     DateTime?
  suspendedReason String?
  reactivatedAt   DateTime?

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile             CandidateProfile?
  emailVerificationTokens EmailVerificationToken[]
  notifications       Notification[]
  sessions            Session[]
  enrolments          Enrolment[]
  payments            Payment[]
  certificates        Certificate[]
  examinationSittings ExaminationSitting[]
  contactRequests     ContactRequest[]
  adminNotes          AdminNote[]

  @@index([accountStatus])
}

// One-to-one, all nullable — the profile-completion modal's output. Which
// conditional fields apply is decided by professionalStatus (see
// src/lib/onboarding.ts); enforced in the Zod schema, not only the UI.
model CandidateProfile {
  candidateId String    @id @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  professionalStatus ProfessionalStatus?
  yearOfCall         Int?                @db.SmallInt // lawyers only, 1960 <= n <= current year
  scnNumber          String?             @db.VarChar(24) // lawyers only
  institution        String?             @db.VarChar(160) // graduates/students
  graduationYear     Int?                @db.SmallInt // graduates/students
  organisation       String?             @db.VarChar(160) // regulated/other
  roleTitle          String?             @db.VarChar(120) // regulated/other
  experienceBand     ExperienceBand?
  placeOfPractice    String?             @db.VarChar(160)
  photoUrl           String?

  handbookAcknowledgedAt DateTime? // checklist step 5
  completedAt            DateTime? // set when the 3-step modal finishes
}

model EmailVerificationToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Store the hash, send the plaintext — never store a usable token.
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([candidateId, consumedAt])
}

enum NotificationCategory {
  ACCOUNT
  CREDENTIAL
  PROGRAMME
  ASSESSMENT
  FINANCE
}

model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  category NotificationCategory
  title    String               @db.VarChar(160)
  body     String
  readAt   DateTime?

  createdAt DateTime @default(now())

  @@index([candidateId, createdAt(sort: Desc)])
}

// Database-backed candidate sessions — deliberately NOT a stateless JWT.
// Suspending an account revokes every live session immediately, which a
// self-contained token can't do. Read via a cached getCurrentCandidate()
// (src/lib/candidate-session.ts): revokedAt IS NOT NULL or
// accountStatus = SUSPENDED both mean signed out. Cookie carries the
// opaque plaintext token; only its hash is ever persisted.
model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime

  revokedAt DateTime? // set on logout, on suspension, on password change
  userAgent String?
  ipAddress String?   @db.Inet

  createdAt DateTime @default(now())

  @@index([candidateId, revokedAt])
}

// ─── Staff, roles & permissions ─────────────────────────────────────────

enum StaffRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  FINANCE_ADMIN
  ACADEMIC_ADMIN
  FACULTY
  SUPPORT_AGENT
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

// The 17-permission catalogue, six categories, per the README table.
enum Permission {
  VIEW_CANDIDATES
  EDIT_CANDIDATES
  VIEW_CONTACT_REQUESTS
  RESOLVE_CONTACT_REQUESTS
  ADD_ADMIN_NOTES
  VIEW_PAYMENTS
  MANAGE_PAYMENTS
  VIEW_GRADES
  GRADE_ASSESSMENTS
  MANAGE_PROGRAMMES
  MANAGE_INTAKES
  ISSUE_CERTIFICATES
  REVOKE_CERTIFICATES
  VIEW_AUDIT_LOG
  EXPORT_DATA
  MANAGE_STAFF
  SUPER_ADMIN
}

model Staff {
  id String @id @default(cuid())

  name       String
  email      String  @unique // the login
  phone      String?
  jobTitle   String?
  department String?

  lineManagerId String?
  lineManager   Staff?  @relation("StaffReports", fields: [lineManagerId], references: [id])
  reports       Staff[] @relation("StaffReports")

  role   StaffRole
  status StaffStatus @default(ACTIVE)

  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissionGrants PermissionGrant[]

  auditEvents             AuditEvent[]
  resolvedContactRequests ContactRequest[] @relation("ContactRequestResolvedBy")
  adminNotesAuthored      AdminNote[]
  revokedCertificates     Certificate[]    @relation("CertificateRevokedBy")

  @@index([role])
  @@index([status])
}

// Explicit per-staff permission set. Seeded from the role's preset on
// creation or when a preset is (re-)applied; individual toggles update
// rows here directly and save immediately (README: "toggling saves
// immediately and writes to the audit log"). super_admin's SUPER_ADMIN
// grant bypasses every other check — see src/lib/permissions.ts.
model PermissionGrant {
  id         String     @id @default(cuid())
  staffId    String
  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  permission Permission
  granted    Boolean    @default(true)
  updatedAt  DateTime   @updatedAt

  @@unique([staffId, permission])
}

// ─── Programme, module, lecture ─────────────────────────────────────────

enum ProgrammeTier {
  FOUNDATION
  SPECIALIST
  ADVANCED_PRACTITIONER
}

// Website listing state machine: draft -> live (published) -> draft.
// Only live programmes appear in the public catalogue.
enum ProgrammeStatus {
  DRAFT
  LIVE
}

model Programme {
  id    String @id @default(cuid())
  title String
  code  String @unique // e.g. ELR-201

  tier                  ProgrammeTier
  category              String
  lengthWeeks           Int
  weeklyCommitmentHours Int
  credits               Int
  feeNaira              Decimal         @db.Decimal(12, 2)
  status                ProgrammeStatus @default(DRAFT)
  description           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules      Module[]
  cohorts      Cohort[]
  enrolments   Enrolment[]
  payments     Payment[]
  certificates Certificate[]
  examination  Examination?

  @@index([status])
  @@index([tier])
}

enum ModuleStatus {
  DRAFT
  PUBLISHED
}

model Module {
  id          String    @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  weekNumber Int
  title      String
  status     ModuleStatus @default(DRAFT)
  // Business rule 6: publishing is blocked while a module has fewer
  // approved objective questions than this draw count.
  questionDrawCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lectures  Lecture[]
  questions Question[]

  @@unique([programmeId, weekNumber])
}

enum LectureMedia {
  SLIDES
  VIDEO
}

// Business rule 15: narration is configurable per lecture — per-slide with
// auto-advance, or one track for the whole lecture. Duration is derived
// from the uploaded audio at ingest time, not entered by hand.
enum NarrationMode {
  PER_SLIDE
  SINGLE_TRACK
}

model Lecture {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title    String
  media    LectureMedia
  mediaUrl String?

  narrationMode         NarrationMode @default(PER_SLIDE)
  narrationAutoAdvance  Boolean       @default(true)
  narrationDurationSecs Int?

  hasScenario         Boolean @default(false)
  hasDraftingExercise Boolean @default(false)
  hasQuiz             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Intake, cohort, enrolment ──────────────────────────────────────────

enum IntakeType {
  JANUARY
  APRIL
  SEPTEMBER
}

model Intake {
  id        String     @id @default(cuid())
  label     String // e.g. "September 2026"
  type      IntakeType
  startDate DateTime

  createdAt DateTime @default(now())

  cohorts             Cohort[]
  examinationSittings ExaminationSitting[]

  @@unique([type, startDate])
}

model Cohort {
  id          String    @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  intakeId    String
  intake      Intake    @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  label       String

  createdAt DateTime @default(now())

  enrolments Enrolment[]

  @@unique([programmeId, intakeId, label])
}

enum EnrolmentStatus {
  ACTIVE
  COMPLETED
  PENDING_PAYMENT
  REFUNDED
}

model Enrolment {
  id          String    @id @default(cuid())
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])
  cohortId    String?
  cohort      Cohort?   @relation(fields: [cohortId], references: [id])

  // Business rule 2: cohort/intake assignment, and this record's existence
  // at all, follow confirmed payment — not acceptance.
  status      EnrolmentStatus @default(PENDING_PAYMENT)
  enrolledAt  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([programmeId])
}

// ─── Payments ────────────────────────────────────────────────────────────

enum PaymentPurpose {
  PROGRAMME
  EXAMINATION
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
  REFUNDED
}

model Payment {
  id          String    @id @default(cuid())
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  purpose              PaymentPurpose
  programmeId          String?
  programme            Programme?          @relation(fields: [programmeId], references: [id])
  examinationSittingId String?
  examinationSitting   ExaminationSitting? @relation(fields: [examinationSittingId], references: [id])

  amountNaira Decimal       @db.Decimal(12, 2)
  provider    String
  reference   String        @unique
  status      PaymentStatus @default(PENDING)

  initiatedAt DateTime  @default(now())
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([status])
}

// ─── Assessment: question bank & examination ────────────────────────────

enum QuestionType {
  MCQ
  THEORY
}

enum QuestionDifficulty {
  STANDARD
  TESTING
  ADVANCED
}

// Business rule 8/9: retiring withdraws a question from future draws but
// preserves the record and can be restored; editing applies to future
// sittings only.
enum QuestionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED
}

model Question {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  type       QuestionType
  text       String
  marks      Int
  difficulty QuestionDifficulty?
  minWords   Int? // theory only
  guidance   String? // theory only — marking guidance, not shown to candidates

  status    QuestionStatus @default(DRAFT)
  retiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId, status])
}

model Examination {
  id          String    @id @default(cuid())
  programmeId String    @unique
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  feeNaira        Decimal @db.Decimal(12, 2)
  durationMinutes Int
  passMarkPct     Int     @default(60)
  attemptsPolicy  String  @default("One resit on referral")

  proctored Boolean @default(true)
  remote    Boolean @default(true)

  fullscreenRequired Boolean @default(true)
  tabSwitchWarning   Boolean @default(true)
  shuffleQuestions   Boolean @default(true)
  shuffleOptions     Boolean @default(false)
  reviewAllowed      Boolean @default(true)

  // Business rule 6: publishing is blocked while any module is short on
  // approved objective questions for its draw count.
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sittings ExaminationSitting[]
}

// registered -> sat -> passed | referred
//            -> forfeited (on quit)
enum SittingStatus {
  REGISTERED
  SAT
  PASSED
  REFERRED
  FORFEITED
}

model ExaminationSitting {
  id            String      @id @default(cuid())
  examinationId String
  examination   Examination @relation(fields: [examinationId], references: [id])
  candidateId   String      @db.Uuid
  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  intakeId      String
  intake        Intake      @relation(fields: [intakeId], references: [id])

  status SittingStatus @default(REGISTERED)

  registeredAt DateTime  @default(now())
  satAt        DateTime?
  // Weighted composite per business rule 7: quizzes 20%, drafting 40%,
  // examination 40%. Grade bands: Distinction / Merit / Pass / Refer.
  finalScorePct Decimal? @db.Decimal(5, 2)
  grade         Grade?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([status])
}

enum Grade {
  DISTINCTION
  MERIT
  PASS
  REFER
}

// ─── Certificates ────────────────────────────────────────────────────────

// active -> revoked (mandatory reason, audit-logged)
// active -> reissued (creates a NEW identifier; the previous one is retired)
enum CertificateStatus {
  ACTIVE
  REVOKED
}

model Certificate {
  id         String @id @default(cuid())
  identifier String @unique // e.g. LVL-CERT-2026-01188

  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])

  tier  ProgrammeTier
  grade Grade

  issuedAt DateTime          @default(now())
  status   CertificateStatus @default(ACTIVE)

  revokedReason     String?
  revokedAt         DateTime?
  revokedByStaffId  String?
  revokedBy         Staff?     @relation("CertificateRevokedBy", fields: [revokedByStaffId], references: [id])

  // Reissue chain — course access is unaffected by revocation (README);
  // only the credential document itself is retired/replaced.
  replacesCertificateId String?      @unique
  replaces               Certificate? @relation("CertificateReissue", fields: [replacesCertificateId], references: [id])
  supersededBy            Certificate? @relation("CertificateReissue")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([status])
}

// ─── Support ─────────────────────────────────────────────────────────────

enum ContactRequestStatus {
  OPEN
  RESOLVED
}

model ContactRequest {
  id          String    @id @default(cuid())
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  category String
  subject  String
  message  String

  status            ContactRequestStatus @default(OPEN)
  resolvedByStaffId String?
  resolvedBy        Staff?               @relation("ContactRequestResolvedBy", fields: [resolvedByStaffId], references: [id])
  resolvedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Internal notes on a candidate profile — distinct from contact-request
// resolution; gated by its own permission (add_admin_notes).
model AdminNote {
  id          String    @id @default(cuid())
  candidateId String    @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  staffId     String
  staff       Staff     @relation(fields: [staffId], references: [id])

  note String

  createdAt DateTime @default(now())

  @@index([candidateId])
}

// ─── Audit ───────────────────────────────────────────────────────────────

// Append-only by contract (Handoff 01): the application DB role holds only
// INSERT and SELECT on this table — see prisma/migrations/*_audit_grants
// for the REVOKE. subjectId/actorStaffId stay plain String (not @db.Uuid):
// this table is polymorphic across subjects that are genuinely uuid
// (Candidate) and subjects that are still cuid-keyed from the foundation
// schema (Staff, Certificate, Payment, Question, ...) — a strict uuid
// column would reject the latter. Documented as a spec deviation.
model AuditEvent {
  id BigInt @id @default(autoincrement())

  actorStaffId String?
  actor        Staff?  @relation(fields: [actorStaffId], references: [id])

  subjectType String  @db.VarChar(40) // "candidate", "certificate", "payment", "staff", "question", …
  subjectId   String
  action      String  @db.VarChar(80) // "candidate.suspended", "candidate.reactivated", …
  description String // the human-readable label the audit log renders
  reason      String? // mandatory for destructive actions — enforced per action, not by column
  ipAddress   String? @db.Inet

  createdAt DateTime @default(now())

  @@index([subjectType, subjectId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_event")
}

// ─── Rate limiting ───────────────────────────────────────────────────────

// Fixed-window counter, Postgres-backed so it survives serverless (an
// in-memory limiter does not). Keyed by an arbitrary bucket string, e.g.
// "register:ip:203.0.113.4" or "signIn:email:c.okonji@chambers.ng" — see
// src/lib/rate-limit.ts.
model RateLimitAttempt {
  id          BigInt   @id @default(autoincrement())
  bucketKey   String
  windowStart DateTime
  count       Int      @default(1)

  @@unique([bucketKey, windowStart])
}
