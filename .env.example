# App runtime connects as the restricted "lavelle_app" role (no UPDATE/DELETE
# on audit_event — see prisma/migrations/*_app_role_audit_grants). That role
# is created by the migration itself with a placeholder password; set a real
# one with: ALTER ROLE lavelle_app PASSWORD '...';
DATABASE_URL="postgresql://lavelle_app:CHANGEME_LAVELLE_APP_DEV_PASSWORD@localhost:5432/lavelle_db?schema=public"
# prisma migrate/db push need elevated privileges (CREATE, role management) —
# point this at a superuser/owner role instead. Not used at app runtime.
MIGRATE_DATABASE_URL="postgresql://postgres@localhost:5432/lavelle_db?schema=public"

# Base URL used to build links in dev-stand-in "emails" (verification,
# staff invitations, password resets).
NEXTAUTH_URL="http://localhost:3000"

# Candidate session token hashing — hand-rolled DB sessions, not a
# third-party auth library (see src/lib/candidate-session.ts). Generate
# with: openssl rand -hex 32
CANDIDATE_SESSION_SECRET="replace-with-a-generated-secret"

# Staff session token hashing (src/lib/staff-session.ts) — a separate
# secret from the candidate one so the two token spaces can never
# cross-validate. Generate with: openssl rand -hex 32
STAFF_SESSION_SECRET="replace-with-a-generated-secret"

# Signs presigned upload/download URLs for the local dev storage shim
# (src/lib/storage.ts). Generate with: openssl rand -hex 32
UPLOAD_SIGNING_SECRET="replace-with-a-generated-secret"

# Signs webhook deliveries for the local dev payment-provider stub
# (src/lib/payment-provider.ts). Generate with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET="replace-with-a-generated-secret"

# Nomba payment provider (src/lib/payment-provider.ts). NOMBA_API_URL picks
# the environment per-deploy rather than hard-coding it — production
# https://api.nomba.com or sandbox https://sandbox.nomba.com. Using
# sandbox credentials against the production URL (or vice versa) fails
# with a 404 "Client record not found" from Nomba's own API.
NOMBA_API_URL="https://api.nomba.com"
NOMBA_ACCOUNT_ID="replace-with-nomba-account-id"
NOMBA_CLIENT_ID="replace-with-nomba-client-id"
NOMBA_PRIVATE_KEY="replace-with-nomba-client-secret"
# Signature key from Nomba dashboard > Developer > Webhook Setup.
NOMBA_WEBHOOK_SECRET="replace-with-nomba-webhook-signature-key"

# SMTP Configuration for transactional email delivery
# Store actual credentials in .env.local (development) or deployment secrets (production)
# Never commit real credentials to Git
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="oluwatomisin.owolabi@yahoo.com"
SMTP_PASS="replace-with-actual-smtp-password"
SMTP_ENC="tls"
SENDER_EMAIL="info@traverse.com.ng"
SENDER_NAME="Traverse"

# DigitalOcean Spaces (S3-compatible object storage) for uploads —
# video, image, PDF, and document storage (src/lib/storage.ts).
# DO_SPACES_ENDPOINT is the region endpoint shown in the Spaces console,
# e.g. "https://ams3.digitaloceanspaces.com". DO_SPACES_REGION is the
# region slug from that endpoint, e.g. "ams3" — Spaces itself ignores the
# value but the S3 SDK requires one set.
DO_SPACES_ENDPOINT="https://ams3.digitaloceanspaces.com"
DO_SPACES_REGION="ams3"
DO_SPACES_BUCKET="lavelle-staging"
DO_SPACES_KEY="your-spaces-access-key-id"
DO_SPACES_SECRET="your-spaces-secret-access-key"

# Email Configuration - Support & Policy
SUPPORT_PHONE="+234 XXX XXX XXXX"
SUPPORT_EMAIL="candidates@lavelle.ng"
SECURITY_EMAIL="security@lavelle.ng"
EXAM_COORDINATOR_EMAIL="exams@lavelle.ng"

# Certificate Appeals & Marking Turnaround
APPEAL_DEADLINE_DAYS="5"
MARKING_TURNAROUND_FOUNDATION="5"
MARKING_TURNAROUND_SPECIALIST="7"
MARKING_TURNAROUND_ADVANCED="10"
