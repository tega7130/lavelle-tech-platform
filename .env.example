# Point this at whatever Postgres you're running locally.
# Option A — a local Postgres install (Postgres.app, homebrew, etc.):
DATABASE_URL="postgresql://postgres@localhost:5432/lavelle_db?schema=public"
# Option B — docker-compose Postgres (npm run db:up):
# DATABASE_URL="postgresql://lavelle:lavelle@localhost:5432/lavelle?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-with-a-generated-secret"
NEXTAUTH_URL="http://localhost:3000"
